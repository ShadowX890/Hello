local NOCLIP_PARTS = { "Head", "Torso", "UpperTorso", "LowerTorso" }
local noclipOriginal = {}  -- store original CanCollide per part
local noclipActive   = false

function setNoclip(enabled)
    if noclipActive == enabled then return end
    noclipActive = enabled
    local char = Character
    if not char then return end
    for _, partName in ipairs(NOCLIP_PARTS) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if enabled then
                noclipOriginal[partName] = part.CanCollide
                part.CanCollide = false
            else
                -- restore original value
                part.CanCollide = (noclipOriginal[partName] ~= nil)
                    and noclipOriginal[partName] or true
            end
        end
    end
    if not enabled then
        noclipOriginal = {}
    end
end

-- keep noclip every frame (Roblox resets CanCollide on physics steps)
task.spawn(function()
    while true do
        -- was task.wait(0) (60 wakeups/sec even while noclip was off)
        if not noclipActive then task.wait(0.3) continue end
        task.wait()
        if noclipActive then
            local char = Character
            if char then
                for _, partName in ipairs(NOCLIP_PARTS) do
                    local part = char:FindFirstChild(partName)
                    if part and part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end
end)


    local ClassShopBuy = NetRayRemotes and NetRayRemotes:FindFirstChild("ClassShopBuy")
    if not ClassShopBuy then
        WindUI:Notify({
            Title    = "Class Shop",
            Content  = "ClassShopBuy remote not found.",
            Duration = 4,
            Icon     = "alert-circle",
        })
        return false
    end
    -- encode payload เหมือนตัวอย่าง: { ClassName = className }
    -- ใช้ NetRay DynamicSender ผ่าน FireServer โดยตรงเหมือน spy capture
    local ok, err = pcall(function()
        local DynamicSender = require(
            game:GetService("ReplicatedStorage")
                :WaitForChild("Modules")
                :WaitForChild("NetRay")
                :WaitForChild("Shared")
                :WaitForChild("DynamicSender")
        )
        DynamicSender:Send(ClassShopBuy, { ClassName = className })
    end)
    if not ok then
        -- fallback: FireServer ตรงแบบ spy
        pcall(function()
            local payload = { ClassName = className }
            ClassShopBuy:FireServer(payload, {})
        end)
    end
    return true
end


--  AUTO EQUIP SYSTEM
-- ═══════════════════════════════════════════════════

-- Encode SET_HOTBAR: move item from inventory slot to hotbar slot
-- Helper: สร้าง buffer จาก array ของ bytes (รองรับค่า 0-255 ทุกตัว)
-- Helper: แปลง number → byte (0-255) โดยไม่ใช้ bitwise operator
local function toByte(n)
    return math.floor(n) % 256
end

-- SET_HOTBAR header: F1=strategy, 43=remote_id, 24 00=payload_len(36) LE, 00=flags
-- payload = 36 bytes คงที่ (inv slot และ hotbar slot เปลี่ยนแค่ค่าไม่เปลี่ยนขนาด)
local function buildSetHotbarBuffer(invSlot, hotbarSlot)
    local s = string.char(
        0xF1, 0x43, 0x24, 0x00, 0x00,          -- header: strategy, remote_id, paylen=36 LE, flags
        0x02, 0x09,
        0x07, 0x03, 0x69, 0x6E, 0x76,          -- key: "inv"
        0x03, toByte(invSlot),                  -- NumberU8: inv slot
        0x07, 0x02, 0x6F, 0x70,                 -- key: "op"
        0x07, 0x0A,                             -- String len 10
        0x53, 0x45, 0x54, 0x5F, 0x48, 0x4F, 0x54, 0x42, 0x41, 0x52,  -- "SET_HOTBAR"
        0x07, 0x06, 0x68, 0x6F, 0x74, 0x62, 0x61, 0x72,  -- key: "hotbar"
        0x03, toByte(hotbarSlot),               -- NumberU8: hotbar slot
        0x0A                                    -- end marker
    )
    return buffer.fromstring(s)
end

-- USE_HOTBAR header: F1=strategy, 43=remote_id, 1D 00=payload_len(29) LE, 00=flags
-- payload = 29 bytes คงที่
local function buildUseHotbarBuffer(hotbarSlot)
    local s = string.char(
        0xF1, 0x43, 0x1D, 0x00, 0x00,          -- header: strategy, remote_id, paylen=29 LE, flags
        0x02, 0x09,
        0x07, 0x06, 0x68, 0x6F, 0x74, 0x62, 0x61, 0x72,  -- key: "hotbar"
        0x03, toByte(hotbarSlot),               -- NumberU8: hotbar slot
        0x07, 0x02, 0x6F, 0x70,                 -- key: "op"
        0x07, 0x0A,                             -- String len 10
        0x55, 0x53, 0x45, 0x5F, 0x48, 0x4F, 0x54, 0x42, 0x41, 0x52,  -- "USE_HOTBAR"
        0x0A                                    -- end marker
    )
    return buffer.fromstring(s)
end

-- CHEST_ANIM_OPEN buffer: F1 43 4A 00 00 | chestNetId={uuid} | op=CHEST_ANIM_OPEN
-- จาก spy: "\241CJ\000\000\002\t\a\nchestNetId\a${uuid}\a\002op\a\015CHEST_ANIM_OPEN\n"
-- 0x4A=74 = payload size
local function buildChestOpenBuffer(netId)
    if not netId or netId == "" then return nil end
    -- \a\n = key length 10, then "chestNetId"
    -- \a\$ = string marker, then len byte, then uuid string
    -- \a\002op\a\015CHEST_ANIM_OPEN
    local uuidLen = #netId
    local s = "\241\067\074\000\000"  -- F1 43 4A 00 00
        .. "\002\009"                  -- map start
        .. "\007\010chestNetId"        -- key "chestNetId" (len=10)
        .. "\007" .. string.char(uuidLen) .. netId  -- string: uuid
        .. "\007\002op"                -- key "op" (len=2)
        .. "\007\015CHEST_ANIM_OPEN"   -- string: "CHEST_ANIM_OPEN" (len=15)
        .. "\010"                      -- end
    return buffer.fromstring(s)
end

-- ─── Normalize ItemId: ตัด $ นำหน้าออก และ uppercase ──────
function normalizeId(id)
    if not id then return "" end
    -- ตัด $ ที่อาจอยู่หน้า id ออก แล้ว uppercase
    return (id:gsub("^%$+", "")):upper()
end

-- ─── Find item in Inventory ──────────────────────────
-- Returns invSlot (1-based) or nil
local function findItemInInventory(itemId)
    if not Inventory then return nil end
    local target = normalizeId(itemId)
    local maxSlots = Inventory:GetAttribute("MaxSlots") or 32
    for i = 1, maxSlots do
        local id = Inventory:GetAttribute("Slot" .. i .. "_ItemId")
        if id and normalizeId(id) == target then
            return i
        end
    end
    return nil
end

-- ─── Find item already in Hotbar ────────────────────
-- Hotbar Slot{n} stores the INVENTORY slot number (1-32)
-- cross-reference กับ Inventory attribute เพื่อหา item
-- Returns hotbarSlot (1-based) or nil
local function findItemInHotbar(itemId)
    if not Hotbar or not Inventory then return nil end
    local target = normalizeId(itemId)
    local maxHotbar = Hotbar:GetAttribute("MaxSlots") or 5
    for h = 1, maxHotbar do
        local invSlotNum = Hotbar:GetAttribute("Slot" .. h)
        if invSlotNum and invSlotNum > 0 then
            local id = Inventory:GetAttribute("Slot" .. invSlotNum .. "_ItemId")
            if id and normalizeId(id) == target then
                return h
            end
        end
    end
    return nil
end

-- ─── Get first free Hotbar slot ─────────────────────
-- A hotbar slot is free when its value is 0 or nil (no inv slot assigned)
local function getFreeHotbarSlot()
    if not Hotbar then return nil end
    local maxSlots = Hotbar:GetAttribute("MaxSlots") or 5
    for i = 1, maxSlots do
        local v = Hotbar:GetAttribute("Slot" .. i)
        if not v or v == 0 then
            return i
        end
    end
    return 1  -- fallback: overwrite slot 1
end


-- REMOVE_FROM_HOTBAR: payload = 36 bytes เท่ากับ SET_HOTBAR (แค่ invSlot=0)
local function buildRemoveHotbarBuffer(hotbarSlot)
    local s = string.char(
        0xF1, 0x43, 0x24, 0x00, 0x00,          -- header: paylen=36 LE
        0x02, 0x09,
        0x07, 0x03, 0x69, 0x6E, 0x76,          -- key: "inv"
        0x03, 0x00,                             -- inv slot = 0 = remove
        0x07, 0x02, 0x6F, 0x70,                 -- key: "op"
        0x07, 0x0A,                             -- String len 10
        0x53, 0x45, 0x54, 0x5F, 0x48, 0x4F, 0x54, 0x42, 0x41, 0x52,  -- "SET_HOTBAR"
        0x07, 0x06, 0x68, 0x6F, 0x74, 0x62, 0x61, 0x72,  -- key: "hotbar"
        0x03, toByte(hotbarSlot),               -- NumberU8: hotbar slot
        0x0A                                    -- end marker
    )
    return buffer.fromstring(s)
end

-- Remove item from hotbar by itemId (put back to just inventory)
local function removeFromHotbar(itemId)
    if not ItemAPIRemote or not Hotbar then return false end
    local hotbarSlot = findItemInHotbar(itemId)
    if not hotbarSlot then return false end
    pcall(function()
        ItemAPIRemote:FireServer(
            buildRemoveHotbarBuffer(hotbarSlot),
            {}
        )
    end)
    task.wait(0.2)
    return true
end

-- Remove all items from hotbar
local function clearHotbar()
    if not Hotbar then return end
    local maxSlots = Hotbar:GetAttribute("MaxSlots") or 5
    for i = 1, maxSlots do
        local v = Hotbar:GetAttribute("Slot" .. i)
        if v and v > 0 then
            pcall(function()
                ItemAPIRemote:FireServer(
                    buildRemoveHotbarBuffer(i),
                    {}
                )
            end)
            task.wait(0.15)
        end
    end
end

-- ─── Main equip function ─────────────────────────────
-- itemId: e.g. "STONE_AXE", "STONE_PICKAXE"
-- Returns true if equipped successfully
local function equipItem(itemId)
    if not ItemAPIRemote then return false end

    -- 1. Already in hotbar?
    local hotbarSlot = findItemInHotbar(itemId)

    if not hotbarSlot then
        -- 2. Find in inventory
        local invSlot = findItemInInventory(itemId)
        if not invSlot then
            return false  -- ไม่มีของชิ้นนี้ใน inventory เลย
        end
        -- 3. หาช่อง hotbar ที่ว่าง
        hotbarSlot = getFreeHotbarSlot()
        -- 4. ย้ายจาก inventory → hotbar
        pcall(function()
            ItemAPIRemote:FireServer(
                buildSetHotbarBuffer(invSlot, hotbarSlot),
                {}
            )
        end)
        task.wait(0.3)
    end

    -- 5. ถือของใน hotbar slot นั้น
    pcall(function()
        ItemAPIRemote:FireServer(
            buildUseHotbarBuffer(hotbarSlot),
            {}
        )
    end)
    task.wait(0.2)
    return true
end

-- ─── Auto Equip state ───────────────────────────────
local autoEquipEnabled  = false
local equipTargetItem   = ""   -- item id ที่เลือกไว้
-- ล็อก Auto Equip ชั่วคราวหลัง Auto Eat resume (ป้องกันแย่งถือ)

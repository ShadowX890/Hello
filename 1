--  MOB / PLAYER ESP
-- ═══════════════════════════════════════════════════
local mobEspEnabled = false
local mobEspRange   = 0        -- 0 = ไม่จำกัดระยะ
local mobHighlights = {}       -- [obj] = Highlight
local mobLabels     = {}       -- [obj] = BillboardGui

local MOB_COLOR_MONSTER = Color3.fromRGB(255,  70,  70)  -- แดง
local MOB_COLOR_PLAYER  = Color3.fromRGB( 80, 150, 255)  -- ฟ้า
local MOB_COLOR_TAMED   = Color3.fromRGB( 80, 230, 120)  -- เขียว

local function mobKind(obj)
    if isPlayerCharacter(obj) then return "player" end
    if obj:GetAttribute("Owner") ~= nil or obj:GetAttribute("OwnerUserId") ~= nil then return "tamed" end
    return "monster"
end
local function mobColor(kind)
    if kind == "player" then return MOB_COLOR_PLAYER
    elseif kind == "tamed" then return MOB_COLOR_TAMED end
    return MOB_COLOR_MONSTER
end
-- แสดง ESP กับทุกตัวที่ยังไม่ตาย (รวมผู้เล่น/สัตว์เลี้ยง ต่างจาก isAlive ที่ตัดออก)
local function mobVisible(obj)
    if not obj or not obj.Parent then return false end
    local hum = obj:FindFirstChildWhichIsA("Humanoid", true)
    if hum and hum.Health <= 0 then return false end
    return true
end

local function removeMobESP(obj)
    if mobHighlights[obj] then pcall(function() mobHighlights[obj]:Destroy() end); mobHighlights[obj] = nil end
    if mobLabels[obj]     then pcall(function() mobLabels[obj]:Destroy() end);     mobLabels[obj] = nil end
end

local function applyMobESP(obj)
    local kind = mobKind(obj)
    local col  = mobColor(kind)
    if not mobHighlights[obj] then
        local hl = Instance.new("Highlight")
        hl.FillColor = col; hl.OutlineColor = col
        hl.FillTransparency = 0.6; hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = obj; hl.Parent = obj
        mobHighlights[obj] = hl
    end
    if not mobLabels[obj] then
        local adornee = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
        if not adornee then return end
        local bb = Instance.new("BillboardGui")
        bb.Adornee = adornee
        bb.Size = UDim2.new(0, 170, 0, 32)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true; bb.ResetOnSpawn = false
        bb.Name = "_MobESP"; bb.Parent = adornee
        local lbl = Instance.new("TextLabel", bb)
        lbl.Name = "_MobText"
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = col
        lbl.TextStrokeTransparency = 0.4
        lbl.TextScaled = false; lbl.TextSize = 13
        lbl.Font = Enum.Font.GothamBold
        lbl.Text = baseName(obj.Name)
        mobLabels[obj] = bb
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if not mobEspEnabled then
            for obj in pairs(mobHighlights) do removeMobESP(obj) end
            for obj in pairs(mobLabels)     do removeMobESP(obj) end

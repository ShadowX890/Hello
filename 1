-- โยน fuel ทั้งหมด (ทุกช่องที่เลือกไว้) ในการยิง "ครั้งเดียว"
-- โดย concat หลาย THROW message เข้า buffer เดียว (แบบเดียวกับที่เกมทำใน spy)
-- amount เป็น NumberU8 (สูงสุด 255) -> ถ้าช่องไหนมีเกิน 255 จะแตกเป็นหลาย message
-- คืน true ถ้ามีของโยนออกไปอย่างน้อย 1 ชิ้น
local function throwAllFuelAtOnce()
    if not ItemAPIRemote or not Inventory then return false end
    -- set ของ itemId ที่เลือกไว้ (normalize แล้ว)
    local wanted = {}
    for _, name in ipairs(coreFuelItemNames) do
        local id = normalizeId(name)
        if id ~= "" then wanted[id] = true end
    end
    if next(wanted) == nil then return false end

    local maxSlots = Inventory:GetAttribute("MaxSlots") or 32
    local sentAny = false
    for i = 1, maxSlots do
        local id = Inventory:GetAttribute("Slot" .. i .. "_ItemId")
        if id and wanted[normalizeId(id)] then
            -- โยนทั้งสแต็กของช่องนี้ในครั้งเดียว (amount = จำนวนเต็ม)
            local amt = math.floor(Inventory:GetAttribute("Slot" .. i .. "_Amount") or 0)
            if amt > 0 and sendThrow(i, amt) then sentAny = true end
        end
    end
    -- flush ให้ throw ทั้งหมดออกทันที
    if sentAny then flushThrows() end
    return sentAny
end


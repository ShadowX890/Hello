MainTab:Button({
    Title = "Redeem All Codes",
    Desc  = "loc:DSC_044",
    Icon  = "gift",
    Callback = function()
        task.spawn(function()
            local function notify(t)
                task.defer(function() pcall(function() WindUI:Notify(t) end) end)
            end

            local NetRay = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("NetRay"))

            local redeemReq = nil
            local deadline = os.clock() + 10
            while os.clock() < deadline do
                redeemReq = NetRay:RegisterRequestEvent("RedeemCode", { timeout = 10 })
                if redeemReq then break end
                task.wait(0.25)
            end

            if not redeemReq then
                notify({ Title = "Redeem Failed", Content = "RedeemCode service not ready. Try again.", Duration = 5, Icon = "x-circle" })
                return
            end

            local CodeData = game:GetService("Players").LocalPlayer
                :WaitForChild("PlayerDataConfig")
                :WaitForChild("CodeData")

            local codes = {}
            for name, redeemed in pairs(CodeData:GetAttributes()) do
                if redeemed == false then table.insert(codes, name) end
            end

            if #codes == 0 then
                notify({ Title = "Redeem Codes", Content = "No unredeemed codes found.", Duration = 4, Icon = "info" })
                return
            end

            notify({ Title = "Redeem Codes", Content = "Found " .. #codes .. " code(s). Redeeming now...", Duration = 4, Icon = "gift" })

            local success, failed = 0, 0

            for _, code in ipairs(codes) do
                local ok, result = pcall(function()
                    return redeemReq:Request({ Code = code })
                end)
                if ok and result then
                    result:andThen(function(res)
                        if type(res) == "table" then
                            local isOk = res.Ok == true
                            notify({
                                Title    = isOk and "✓ " .. code or "✗ " .. code,
                                Content  = res.Message or (isOk and "Redeemed!" or "Failed."),
                                Duration = 4,
                                Icon     = isOk and "check-circle" or "alert-circle",
                            })
                            if isOk then success += 1 else failed += 1 end
                        end
                    end):catch(function(err)
                        failed += 1
                        notify({ Title = "✗ " .. code, Content = "Request error: " .. tostring(err), Duration = 4, Icon = "alert-circle" })
                    end)
                else
                    failed += 1
                    notify({ Title = "✗ " .. code, Content = "Could not send request.", Duration = 4, Icon = "alert-circle" })
                end
                task.wait(1.5)
            end

            task.wait(0.5)
            notify({ Title = "Redeem Complete", Content = success .. " succeeded, " .. failed .. " failed.", Duration = 5, Icon = "package-check" })
        end)
    end,
})


local opOrigFindByName = nil
local function opApplyExtendedHitbox(on)
    if not opItemAPI then return end
    if on then
        opOrigFindByName = opOrigFindByName or opItemAPI.FindByName
        opItemAPI.FindByName = function(name)
            local item = opOrigFindByName(name)
            if type(item) ~= "table" then return item end
            local patched = {}
            for k, v in pairs(item) do patched[k] = v end
            local base = typeof(patched.HitboxSize) == "Vector3"
                and patched.HitboxSize or Vector3.new(5, 6, 7)
            patched.HitboxSize       = base * opHitboxMult
            patched.CustomHitboxSize = patched.HitboxSize
            return patched
        end
    else
        if opOrigFindByName then
            opItemAPI.FindByName = opOrigFindByName
        end
    end
end

local function opApplyHarvestSpeed(on)
    if not opCfg then return end
    local mult = on and opHarvestMult or 1
    opCfg.HARVEST_M1_SPEED = opOrigValues.HARVEST_M1_SPEED * mult
    opCfg.MELEE_M1_SPEED   = opOrigValues.MELEE_M1_SPEED   * mult
    opCfg.HAND_M1_SPEED    = opOrigValues.HAND_M1_SPEED    * mult
    if opAnimConfig and opAnimConfig.Harvest then
        for _, weaponCfg in pairs(opAnimConfig.Harvest) do
            if type(weaponCfg) == "table" and weaponCfg.Speed ~= nil then
                if not weaponCfg._origSpeed then
                    weaponCfg._origSpeed = weaponCfg.Speed
                end
                weaponCfg.Speed = on and (weaponCfg._origSpeed * mult) or weaponCfg._origSpeed
            end
        end
    end
end


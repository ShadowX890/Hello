    { key = "emerald",   color = Color3.fromRGB( 80, 220, 100) },  -- green
    { key = "ruby",      color = Color3.fromRGB(220,  50,  50) },  -- red
    { key = "shadow",    color = Color3.fromRGB( 80,   0, 160) },  -- purple
    { key = "dark",      color = Color3.fromRGB( 60,  60,  60) },  -- dark

--  AUTO DEPOSIT (ฝากของเข้าหีบเก็บของ)
--  ยืนยันจาก LocalChestUI: op="MOVE_INV_TO_CHEST"
--    { chestNetId, invSlot, chestSlot=0, amount }  ยิงผ่าน NetRay wrapper
-- ═══════════════════════════════════════════════════
local depositEnabled   = false
local depositItemNames = {}
local depositRange     = 40
local depositThreshold = 0.85   -- ฝากเมื่อกระเป๋าใช้ไป >= 85%

local function getInventoryItemNames()
    local seen, list = {}, {}
    if not Inventory then return list end
    local maxSlots = Inventory:GetAttribute("MaxSlots") or 32
    for i = 1, maxSlots do
        local id = Inventory:GetAttribute("Slot" .. i .. "_ItemId")
        if type(id) == "string" and id ~= "" then
            local n = normalizeId(id)
            if n ~= "" and not seen[n] then seen[n] = true; table.insert(list, n) end
        end
    end
    table.sort(list)
    return list
end

local function findNearestChestNetId(range)
    if not BuildParts then return nil end
    local best, bestD = nil, math.huge
    for _, obj in ipairs(BuildParts:GetChildren()) do
        if obj and obj.Parent and obj.Name:lower():find("chest") then
            local nid = getChestNetId(obj)
            if nid then
                local d = distanceTo(obj)
                if d <= range and d < bestD then best = nid; bestD = d end
            end
        end
    end
    return best
end

local function invUsedFraction()
    if not Inventory then return 0 end
    local maxSlots = Inventory:GetAttribute("MaxSlots") or 32
    local used = 0
    for i = 1, maxSlots do
        local id = Inventory:GetAttribute("Slot" .. i .. "_ItemId")
        if type(id) == "string" and id ~= "" then used += 1 end
    end
    return maxSlots > 0 and (used / maxSlots) or 0
end

local function doDeposit()
    if not Inventory then return false end
    local ev = getItemEvent()
    if not ev then return false end
    local nid = findNearestChestNetId(depositRange)
    if not nid then return false end
    local wanted = {}
    for _, name in ipairs(depositItemNames) do
        local n = normalizeId(name)
        if n ~= "" then wanted[n] = true end
    end
    if next(wanted) == nil then return false end
    local maxSlots = Inventory:GetAttribute("MaxSlots") or 32
    local any = false
    for i = 1, maxSlots do
        local id = Inventory:GetAttribute("Slot" .. i .. "_ItemId")
        if type(id) == "string" and wanted[normalizeId(id)] then
            local amt = math.floor(Inventory:GetAttribute("Slot" .. i .. "_Amount") or 0)
            if amt > 0 then
                pcall(function()
                    ev:FireServer({
                        op         = "MOVE_INV_TO_CHEST",
                        chestNetId = nid,
                        invSlot    = i,
                        chestSlot  = 0,
                        amount     = amt,
                    })
                end)
                any = true
            end
        end
    end
    return any
end

task.spawn(function()
    while true do
        if not depositEnabled then task.wait(IDLE_WAIT) continue end
        task.wait(1)
        if #depositItemNames == 0 then continue end
        if invUsedFraction() < depositThreshold then continue end
        doDeposit()
    end
end)


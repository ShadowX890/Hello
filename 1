local function getRoot()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function getObjPos(obj)
    -- GetPivot first: works even if model has no loaded parts (far away / unloaded)
    local ok, cf = pcall(function() return obj:GetPivot() end)
    if ok and cf then return cf.Position end
    if obj:IsA("BasePart") then return obj.Position end
    local bp = obj:FindFirstChildWhichIsA("BasePart", true)
    if bp then return bp.Position end
    return nil
end

local function distanceTo(obj)
    local root = getRoot()
    if not root then return math.huge end
    local pos = getObjPos(obj)
    if not pos then return math.huge end
    return (root.Position - pos).Magnitude
end

local function distanceBetween(posA, posB)
    return (posA - posB).Magnitude
end

-- Model names repeat constantly (Tree, Tree, Tree...), and this used to run two
-- pattern matches per node on every scan. Memoised so each distinct name is
-- parsed once.
local baseNameMemo = {}
-- ═══════════════════════════════════════════════════
--  POLL PACING
--  Every coroutine wakeup is interpreted work. After obfuscation that cost is
--  multiplied, so idle features must not wake the scheduler 10x a second.
--  IDLE_WAIT is used whenever a loop has nothing to do.
-- ═══════════════════════════════════════════════════
local IDLE_WAIT = 0.5

local function baseName(name)
    local hit = baseNameMemo[name]
    if hit then return hit end
    local out = (name:match("^(.-)%s*%d+%s*$") or name):match("^%s*(.-)%s*$")
    baseNameMemo[name] = out
    return out
end

local function teleportTo(pos)
    local root = getRoot()
    if root then
        root.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
    end
end


-- EAT_FOOD remote: "Vitual" (ไม่ใช่ itemAPI_service)
-- buffer: F1 43 11 00 00 02 09 07 02 op 07 08 EAT_FOOD 0A
-- payload = 17 bytes = 0x11

local function buildEatFoodBuffer()
    local s = string.char(
        0xF1, 0x43, 0x11, 0x00, 0x00,          -- header: paylen=17 LE
        0x02, 0x09,
        0x07, 0x02, 0x6F, 0x70,                 -- key: "op"
        0x07, 0x08,                             -- String len 8
        0x45, 0x41, 0x54, 0x5F, 0x46, 0x4F, 0x4F, 0x44,  -- "EAT_FOOD"
        0x0A                                    -- end marker
    )
    return buffer.fromstring(s)
end


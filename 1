-- ── Resource names from the game's node modules ───────────────
-- The map now nests resources inside sub-folders (Natural.SnowyLoad, ...),
-- so scanning the workspace alone can miss anything not streamed in yet.
-- ReplicatedStorage.Modules.Object_Nodes.Natural.*_Obj lists every node type.
local NODE_MODULES = {
    "Plants_Obj", "Rocks_Obj", "Ores_Obj",
    "Herbs_Obj", "Sand_Obj", "DeathForestPlants_Obj",
}

-- Node keys from the modules. The key is what the world model is named
-- ("Pile Of Sand", "Coal Rock", ...), so keys alone give clean dropdown entries.
local NODE_NAME_SET = {}

-- Cached so the UI never pays for this twice.
-- IMPORTANT: no WaitForChild here. In the Lobby these folders do not exist and
-- the chained waits blocked the main thread for up to 30s, which is why tab
-- building stopped at Auto Farm. FindFirstChild returns instantly instead, and
-- the watcher below fills the list in once the game map streams in.
local moduleNamesCache = nil
local moduleSeenCache  = nil

local function getModuleFarmNames()
    if moduleNamesCache then return moduleNamesCache, moduleSeenCache end
    local seen, list = {}, {}
    pcall(function()
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local nodes   = modules and modules:FindFirstChild("Object_Nodes")
        local natural = nodes   and nodes:FindFirstChild("Natural")
        if not natural then return end
        for _, modName in ipairs(NODE_MODULES) do
            local mod = natural:FindFirstChild(modName)
            if mod and mod:IsA("ModuleScript") then
                local ok, data = pcall(require, mod)
                if ok and type(data) == "table" then
                    for key in pairs(data) do
                        local nm = tostring(key)
                        if nm ~= "" and not seen[nm] then
                            seen[nm] = true
                            NODE_NAME_SET[nm] = true
                            table.insert(list, nm)
                        end
                    end
                end
            end
        end
    end)
    if #list > 0 then
        moduleNamesCache, moduleSeenCache = list, seen
    end
    return list, seen
end

-- A real harvest node has a Durability attribute, or its name is a known node.
-- Without this test the scan also picked up parts inside models
-- (Trunk / Leaves / Hitbox / ...), which is what polluted the dropdown.
local function looksLikeNode(obj)
    if obj:GetAttribute("Durability") ~= nil then return true end
    return NODE_NAME_SET[baseName(obj.Name)] == true
end

-- Walk sub-folders only (never into a model's parts) and collect node names
local function addNamesDeep(root, seen, list, depth)
    if not root or (depth or 0) > 3 then return end
    pcall(function()
        for _, obj in ipairs(root:GetChildren()) do
            if obj:IsA("Folder") then
                addNamesDeep(obj, seen, list, (depth or 0) + 1)
            elseif looksLikeNode(obj) then
                local bn = baseName(obj.Name)
                if bn ~= "" and not seen[bn] then
                    seen[bn] = true
                    table.insert(list, bn)
                end
            end
        end
    end)
end

-- Merge module names + Natural nodes + BuildParts (deduplicated)
local function getAllFarmNames()
    local list, seen = getModuleFarmNames()
    addNamesDeep(Natural, seen, list, 0)
    pcall(function()
        for _, obj in ipairs(BuildParts:GetChildren()) do
            if isBuildFarmable(obj.Name) then
                local bn = baseName(obj.Name)
                if bn ~= "" and not seen[bn] then
                    seen[bn] = true
                    table.insert(list, bn)
                end
            end
        end
    end)
    table.sort(list)
    return list
end


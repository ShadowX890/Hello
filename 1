--  CHEST LOOT PREVIEW (จาก ChestLootTables) — โชว์ลูทเด่นบน ESP
-- ═══════════════════════════════════════════════════
local espLootEnabled = false

local _lootTables = nil
local _lootWarned = false
local function getLootTables()
    if _lootTables then return _lootTables end
    -- ลองหลายเส้นทางหา ChestLootTables (บางเกม nest ไว้คนละที่)
    local candidates = {
        function() return require(game:GetService("ReplicatedStorage")
            .Modules.Misc.Utility.ChestLootTables) end,
        function()
            local u = require(game:GetService("ReplicatedStorage")
                .Modules.Misc.Utility)
            return u and u.ChestLootTables
        end,
        function()
            local found
            for _, d in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                if d.Name == "ChestLootTables" and d:IsA("ModuleScript") then
                    found = require(d); break
                end
            end
            return found
        end,
    }
    for _, fn in ipairs(candidates) do
        local ok, mod = pcall(fn)
        if ok and type(mod) == "table" then
            _lootTables = mod
            return _lootTables
        end
    end
    if not _lootWarned then
        _lootWarned = true
        pcall(function() warn("[ChestLootESP] load ChestLootTables ไม่สำเร็จ") end)
    end
    return nil
end

-- map หีบ -> ชื่อ loot table (จาก ChestPresetSetUp: Wooden=Common, Silver=Rare,
-- Golden=Weapons_Rare_Roll, Supreme=Supreme_Roll)
local function getChestLootTableName(obj)
    local keys = {
        obj:GetAttribute("_SetupChestPreset"),
        obj:GetAttribute("ChestPreset"),
        obj.Name,
    }
    for _, k in ipairs(keys) do
        if type(k) == "string" then
            local p = k:lower()
            if p:find("supreme") then return "Supreme_Roll" end
            if p:find("golden")  then return "Weapons_Rare_Roll" end
            if p:find("silver")  then return "Rare" end
            if p:find("wooden")  then return "Common" end
        end
    end
    return nil
end

-- คืน string ลูทเด่น (rare สุด topN อัน) — cache ตามชื่อ table เพื่อไม่ให้แล็ค
local _lootPreviewCache = {}
local _lootWarned2, _lootWarned3 = false, false
local function getChestLootPreview(obj, topN)
    topN = topN or 3
    local tableName = getChestLootTableName(obj)
    if not tableName then
        if not _lootWarned2 then
            _lootWarned2 = true
            pcall(function() warn("[ChestLootESP] แมพหีบไม่เจอ table:", obj.Name) end)
        end
        return ""
    end
    -- cache เฉพาะผลที่สำเร็จ (ไม่ cache ค่าว่าง -> จะได้ลองใหม่)
    local cached = _lootPreviewCache[tableName]
    if cached and cached ~= "" then return cached end
    local tables = getLootTables()
    local entries = tables and tables[tableName]
    if type(entries) ~= "table" then
        if not _lootWarned3 then
            _lootWarned3 = true
            pcall(function() warn("[ChestLootESP] ไม่เจอ entries ของ table:", tableName,
                "| มี tables ไหม:", tables ~= nil) end)
        end
        return ""
    end
    local list = {}
    for _, e in ipairs(entries) do
        if type(e) == "table" and e.Id then list[#list + 1] = e end
    end
    -- เรียงตาม Chance น้อย -> มาก (rare สุดขึ้นก่อน)
    table.sort(list, function(a, b) return (a.Chance or 999) < (b.Chance or 999) end)
    local function prettyId(id)
        local x = tostring(id):gsub("_", " "):lower()
        x = x:gsub("(%a)([%w]*)", function(a, b) return a:upper() .. b end)
        return x
    end
    local names = {}
    for i = 1, math.min(topN, #list) do names[#names + 1] = prettyId(list[i].Id) end
    local str = table.concat(names, " / ")
    _lootPreviewCache[tableName] = str
    return str
end

local function applyChestLabel(obj)
    if espLabels[obj] then return end
    if not obj or not obj.Parent then return end
    local pos = getObjPos(obj)
    if not pos then return end

    -- need an Adornee BasePart — use PrimaryPart or first BasePart
    local adornee = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)

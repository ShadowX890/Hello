    lbl.BackgroundTransparency = 1
    lbl.TextColor3      = getChestColor(obj)
    lbl.TextStrokeTransparency = 0.5
    lbl.TextScaled      = false
    lbl.TextSize        = 14          -- fixed pixel size, same at any distance
    lbl.Font            = Enum.Font.GothamBold
    lbl.Text            = obj.Name .. "  ? m"
    lbl.Name            = "_ESPText"

    -- บรรทัดลูท (static — ไม่อัปเดตทุกเฟรม)
    if twoLine then
        local loot = Instance.new("TextLabel", bb)
        loot.Name           = "_ESPLoot"
        loot.Size           = UDim2.new(1, 0, 0, 20)
        loot.Position       = UDim2.new(0, 0, 0, 24)
        loot.BackgroundTransparency = 1
        loot.TextColor3     = Color3.fromRGB(255, 235, 150)
        loot.TextStrokeTransparency = 0.4
        loot.TextScaled     = false
        loot.TextSize       = 12
        loot.Font           = Enum.Font.Gotham
        loot.Text           = "\u{2605} " .. lootStr
    end

    espLabels[obj] = bb
end


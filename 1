    local ok, val = pcall(function()
        local label = LocalPlayer.PlayerGui
            :WaitForChild("HUD_Screen", 3)
            :WaitForChild("Left", 3)
            :WaitForChild("HungryBar", 3)
            :WaitForChild("ImageLabel", 3)
            :WaitForChild("Text", 3)
        local text = label.Text  -- "HUNGER : 86/100"
        local current = text:match("(%d+)%s*%/")
        return current and tonumber(current) or 100
    end)
    return (ok and type(val) == "number") and val or 100
end

-- ดึง health value จาก HUD GUI เช่น "HEALTH : 86/100"
local function getHealth()
    local ok, val = pcall(function()
        local label = LocalPlayer.PlayerGui
            :WaitForChild("HUD_Screen", 3)
            :WaitForChild("Left", 3)
            :WaitForChild("HealthBar", 3)
            :WaitForChild("ImageLabel", 3)
            :WaitForChild("Text", 3)
        local text = label.Text  -- "HEALTH : 86/100"
        local current, max = text:match("(%d+)%s*%/%s*(%d+)")
        if current and max then
            return tonumber(current), tonumber(max)
        end
        return 100, 100
    end)
    if not ok then return 100, 100 end
    return val, 100  -- fallback max
end


--  AUTO ITEMS
-- ═══════════════════════════════════════════════════
local itemsEnabled          = false
local autoCollectAllEnabled = false
local itemsDelay            = 0.1
local itemsFilterList       = {}
local itemsUseRange         = false
local itemsRange            = 30

-- ตรวจว่า item นี้ควรเก็บหรือไม่ (ใช้โดย Auto Collect)
-- เก็บเฉพาะ item ที่เลือกใน dropdown เท่านั้น ถ้าไม่เลือก = ไม่เก็บ
local function shouldCollect(obj)
    if #itemsFilterList == 0 then return false end
    if itemsUseRange then
        if distanceTo(obj) > itemsRange then return false end
    end
    local bn = baseName(obj.Name):upper()
    for _, name in ipairs(itemsFilterList) do
        if bn == name:upper() then return true end
    end
    return false
end

-- รวบรวมชื่อ items ที่อยู่ใน ItemsFolder ตอนนี้ (unique)
local function getItemsFolderNames()
    local seen, list = {}, {}
    if not ItemsFolder then return list end
    for _, obj in ipairs(ItemsFolder:GetChildren()) do
        local bn = baseName(obj.Name)
        if bn ~= "" and not seen[bn] then
            seen[bn] = true
            table.insert(list, bn)
        end
    end
    table.sort(list)
    return list
end

local function collectItem(obj)
    if not obj or not obj.Parent then return end
    if not shouldCollect(obj) then return end
    local pos = getObjPos(obj)
    if not pos then return end
    teleportTo(pos)
    task.wait(0.15)
    -- หา PickupPrompt โดยตรงก่อน (ตาม debug: ชื่อ PickupPrompt)
    local fired = false
    pcall(function()
        local pp = obj:FindFirstChild("PickupPrompt", true)
            or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if pp and pp:IsA("ProximityPrompt") then
            fireproximityprompt(pp)
            fired = true
        end
    end)
    if not fired then
        pcall(function()
            for _, v in ipairs(obj:GetDescendants()) do
                if v:IsA("ProximityPrompt") then fireproximityprompt(v); fired = true; break end
                if v:IsA("ClickDetector")   then fireclickdetector(v);   fired = true; break end
            end
        end)
    end
end

local function collectItemForce(obj)
    if not obj or not obj.Parent then return end
    local pos = getObjPos(obj)
    if not pos then return end
    teleportTo(pos)
    task.wait(0.15)
    local fired = false
    pcall(function()
        local pp = obj:FindFirstChild("PickupPrompt", true)
            or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if pp and pp:IsA("ProximityPrompt") then
            fireproximityprompt(pp)
            fired = true
        end
    end)
    if not fired then
        pcall(function()
            for _, v in ipairs(obj:GetDescendants()) do
                if v:IsA("ProximityPrompt") then fireproximityprompt(v); fired = true; break end
                if v:IsA("ClickDetector")   then fireclickdetector(v);   fired = true; break end
            end
        end)
    end
end


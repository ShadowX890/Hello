local function throwOneFuelItem(itemId)
    if not ItemAPIRemote or not itemId or itemId == "" then return false end

    -- 1) หา inventory slot ของไอเทมนี้โดยตรง (นี่คือ "slot" ที่ THROW ต้องใช้)
    local invSlot = findItemInInventory(itemId)

    -- 2) equip ก่อน เพื่อให้ระบบ "ถือของ" ทำงานเหมือนเดิม (ที่ผู้เล่นบอกว่าใช้ได้)
    local hotbarSlot = findItemInHotbar(itemId)
    if not hotbarSlot then
        if moveItemToHotbar(itemId) then
            task.wait(0.3)
            hotbarSlot = findItemInHotbar(itemId)
            -- inventory slot อาจเปลี่ยนหลังย้ายเข้า hotbar -> อ่านใหม่
            invSlot = findItemInInventory(itemId) or invSlot
        end
    end
    if hotbarSlot then
        pcall(function() ItemAPIRemote:FireServer(buildUseHotbarBuffer(hotbarSlot), {}) end)
        task.wait(0.2)
        invSlot = findItemInInventory(itemId) or invSlot
    end

    -- 3) เผื่อยังไม่มี invSlot ให้ลอง map จาก hotbar
    if not invSlot and hotbarSlot and Hotbar then
        invSlot = Hotbar:GetAttribute("Slot" .. hotbarSlot)
    end
    if not invSlot or invSlot <= 0 then return false end

    -- 4) โยนทั้งสแต็กในครั้งเดียวผ่าน NetRay wrapper (เหมือนเกม)
    local amount = getInvSlotQuantity(invSlot)
    sendThrow(invSlot, amount)
    flushThrows()
    return true
end


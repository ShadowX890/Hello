local function getChestColor(obj)
    local lower = obj.Name:lower()
    for _, entry in ipairs(CHEST_COLORS) do
        if lower:find(entry.key) then return entry.color end
    end
    return espColor  -- fallback to user-chosen color
end

local function removeChestESP(obj)
    if espHighlight[obj] then
        pcall(function() espHighlight[obj]:Destroy() end)
        espHighlight[obj] = nil
    end
end

local function applyChestESP(obj)
    if espHighlight[obj] then return end           -- already has one
    if not obj or not obj.Parent then return end
    local hl = Instance.new("Highlight")
    local c = getChestColor(obj)
    hl.FillColor        = c
    hl.OutlineColor     = c
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.DepthMode        = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee          = obj          -- attach directly to model, no part needed
    hl.Parent           = obj
    espHighlight[obj] = hl
end

local function updateESPColor()
    for obj, hl in pairs(espHighlight) do
        if hl and hl.Parent then
            hl.FillColor    = espColor
            hl.OutlineColor = espColor
        end
    end
end


    return list
end



-- ═══════════════════════════════════════════════════
--  AUTO MOVE TO HOTBAR
-- ═══════════════════════════════════════════════════
-- state
local autoMoveEnabled   = false
local moveTargetItems   = {}   -- รายชื่อ item id ที่ต้องการย้ายขึ้น hotbar
local moveDelay         = 0.3  -- หน่วงระหว่าง item แต่ละชิ้น

-- ย้าย item จาก Inventory → Hotbar (แค่วาง slot ไว้ ไม่ได้ equip ให้ถือ)
-- คืนค่า true ถ้าย้ายสำเร็จ
-- evicted slot state: เก็บข้อมูล slot ที่ถูก overwrite ตอน eat เพื่อคืนกลับ
local eatEvictedSlot    = nil  -- hotbar slot ที่ถูกแทนที่ด้วยอาหาร
local eatEvictedInvSlot = nil  -- inv slot ของของเดิมที่ถูกไล่ออก

local function moveItemToHotbar(itemId, trackEvict)
    if not ItemAPIRemote or not Inventory or not Hotbar then return false end

    -- อยู่ใน hotbar แล้ว → ไม่ต้องทำอะไร
    if findItemInHotbar(itemId) then return true end

    local invSlot = findItemInInventory(itemId)
    if not invSlot then return false end

    local hotbarSlot = getFreeHotbarSlot()

    -- ถ้า hotbar เต็ม getFreeHotbarSlot คืน slot 1 (fallback)
    -- จำของที่อยู่ใน slot นั้นก่อน overwrite (เฉพาะตอน eat)
    if trackEvict then
        eatEvictedSlot    = hotbarSlot
        eatEvictedInvSlot = Hotbar:GetAttribute("Slot" .. hotbarSlot) or nil
    end

    pcall(function()
        ItemAPIRemote:FireServer(
            buildSetHotbarBuffer(invSlot, hotbarSlot),
            {}
        )
    end)
    task.wait(0.3)
    return findItemInHotbar(itemId) ~= nil
end

-- Loop: วนทุก item ที่เลือกไว้ ถ้ายังไม่อยู่ใน hotbar → ย้าย
task.spawn(function()
    while true do
        task.wait(moveDelay)
        if not autoMoveEnabled or isEatingPause then continue end
        if #moveTargetItems == 0 then continue end
        if not Inventory or not Hotbar then continue end

        for _, itemId in ipairs(moveTargetItems) do
            if not autoMoveEnabled then break end
            if not findItemInHotbar(itemId) then
                moveItemToHotbar(itemId)
                task.wait(moveDelay)
            end
        end
    end
end)

-- ══════════════════════════════════════════════════
--  CORE FUEL
-- ══════════════════════════════════════════════════
local coreFuelEnabled   = false
local coreFuelItemNames = {}
local MAX_CORE_LEVEL    = 6

local function toByte_early(n) return math.floor(n) % 256 end

-- THROW buffer — ยืนยันจาก remote spy (กดโยนของจริง):
--   { op="THROW", amount=<จำนวน>, slot=<inventory slot> }
--   amount และ slot เป็น NumberU8 (type 0x03) -> รับค่า 0..255
-- ⚠ ของเดิม hardcode amount=255 ซึ่ง server มักปฏิเสธเพราะเกินจำนวนใน stack
--   -> ทำให้ "ไม่โยน" ต้องส่ง amount = จำนวนจริงที่มีในช่องนั้น
-- สร้าง 1 THROW message (37 bytes) เป็น string เพื่อเอาไป "ต่อกัน" ได้
-- NetRay รองรับหลาย message ใน buffer เดียว (ยืนยันจาก spy: 2 THROW ต่อกัน)
-- เกมจำกัดการโยน "ต่อ 1 ครั้ง" ไว้ที่ 99 (ยืนยันจาก spy: amount=99)
-- ส่งเกินนี้ server จะปฏิเสธ -> ไม่โยน
local MAX_THROW_PER_MSG = 99
local function throwMessageStr(invSlot, amount)
    amount  = math.clamp(math.floor(tonumber(amount) or 1), 1, MAX_THROW_PER_MSG)
    invSlot = math.clamp(math.floor(tonumber(invSlot) or 0), 0, 255)
    return string.char(
        0xF1, 0x43, 0x20, 0x00, 0x00,
        0x02, 0x09,
        0x07, 0x02, 0x6F, 0x70,                       -- "op"
        0x07, 0x05, 0x54, 0x48, 0x52, 0x4F, 0x57,     -- "THROW"
        0x07, 0x06, 0x61, 0x6D, 0x6F, 0x75, 0x6E, 0x74, -- "amount"
        0x03, toByte_early(amount),                    -- amount (NumberU8)
        0x07, 0x04, 0x73, 0x6C, 0x6F, 0x74,           -- "slot"
        0x03, toByte_early(invSlot),                   -- slot (NumberU8)
        0x0A
    )
end

-- 1 slot -> buffer เดียว (fallback ถ้า DynamicSender ใช้ไม่ได้)
local function buildThrowBuffer(invSlot, amount)
    return buffer.fromstring(throwMessageStr(invSlot, amount))
end

-- ═══════════════════════════════════════════════════
--  THROW ผ่าน DynamicSender ตัวจริงของเกม (วิธีที่ถูกต้อง)
--  เกมเข้ารหัส/บีบอัด(LZ4)/batch ให้เอง แบบเดียวกับตอนคลิกโยนใน inventory
--  -> ไม่ต้องเปิด inventory และไม่ต้องเดา buffer เอง
-- ═══════════════════════════════════════════════════
-- NetRay event wrapper — วิธีที่เกมใช้จริง (ยืนยันจาก LocalInventoryUI):
--   local v1 = NetRay:GetEvent("itemAPI_service")
--   v1:FireServer({ op="THROW", slot=<invSlot>, amount=<จำนวนเต็มสแต็ก> })
-- wrapper จะ serialize/บีบอัด/ส่งให้เอง -> ไม่ต้องทำ buffer เอง ไม่ต้องเปิด inventory
local _itemEvent = nil
function getItemEvent()
    if _itemEvent then return _itemEvent end
    local ok, ev = pcall(function()
        local NetRay = require(game:GetService("ReplicatedStorage")
            :WaitForChild("Modules"):WaitForChild("NetRay"))
        return NetRay:GetEvent("itemAPI_service")
    end)
    if ok and ev then _itemEvent = ev end
    return _itemEvent
end

-- ยัง require DynamicSender ไว้เผื่ออยาก flush batch เอง
local _dynSender = nil
local function getDynamicSender()
    if _dynSender then return _dynSender end
    local ok, mod = pcall(function()
        return require(game:GetService("ReplicatedStorage")
            :WaitForChild("Modules"):WaitForChild("NetRay")
            :WaitForChild("Shared"):WaitForChild("DynamicSender"))
    end)
    if ok and mod then _dynSender = mod end
    return _dynSender
end

-- ส่ง 1 THROW ของ 1 ช่อง = โยนทั้งสแต็กในครั้งเดียว (เหมือนปุ่ม drop ของเกม)
-- amount ส่งเต็มจำนวนได้เลย (wrapper รองรับตัวเลขใหญ่ผ่าน DynamicSender)
local function sendThrow(invSlot, amount)
    invSlot = math.floor(tonumber(invSlot) or 0)
    amount  = math.floor(tonumber(amount) or 0)
    if invSlot <= 0 or amount <= 0 then return false end
    -- วิธีหลัก: NetRay event wrapper (แบบเดียวกับเกม)
    local ev = getItemEvent()
    if ev then
        local ok = pcall(function()
            ev:FireServer({ op = "THROW", slot = invSlot, amount = amount })
        end)
        if ok then return true end
    end
    -- fallback: raw remote + buffer (แตกก้อนละ 99 เพราะ U8)
    if ItemAPIRemote then
        local rem = amount
        while rem > 0 do
            local chunk = math.min(rem, MAX_THROW_PER_MSG)
            pcall(function() ItemAPIRemote:FireServer(buildThrowBuffer(invSlot, chunk), {}) end)
            rem -= chunk
        end
        return true
    end
    return false
end

-- บังคับ flush batch ทันที (ไม่ต้องรอ Heartbeat) — เผื่ออยากให้โยนออกเร็ว
local function flushThrows()
    local sender = getDynamicSender()
    if sender and sender.FlushBatches then
        pcall(function() sender:FlushBatches(ItemAPIRemote) end)
    end
end


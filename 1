        -- create invisible anchor part so BillboardGui has somewhere to attach
        local anchor = Instance.new("Part")
        anchor.Anchored    = true
        anchor.CanCollide  = false
        anchor.Transparency = 1
        anchor.Size        = Vector3.new(0.1, 0.1, 0.1)
        anchor.CFrame      = CFrame.new(pos + Vector3.new(0, 3, 0))
        anchor.Name        = "_ESPAnchor"
        anchor.Parent      = obj
        adornee = anchor
    end

    -- loot preview (คำนวณครั้งเดียว, cache -> ไม่แล็ค)
    local lootStr = espLootEnabled and getChestLootPreview(obj, 3) or ""
    local twoLine = lootStr ~= ""

    local bb = Instance.new("BillboardGui")

-- ─── Multi-Dropdown custom save/load (writefile/readfile) ───

local function saveDropdowns()
    local data = {
        FarmDropdown   = farmTargets,
        AliveDropdown  = aliveTargets,
        ChestDropdown  = chestTargets,
    }
    pcall(function()
        writefile(DROPDOWN_SAVE_PATH, game:GetService("HttpService"):JSONEncode(data))
    end)
end

local function loadDropdowns()
    pcall(function()
        if not isfile(DROPDOWN_SAVE_PATH) then return end
        local raw = readfile(DROPDOWN_SAVE_PATH)
        local ok, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(raw)
        end)
        if not ok or type(data) ~= "table" then return end

        -- Farm Dropdown (multi → Set with table)
        if type(data.FarmDropdown) == "table" and #data.FarmDropdown > 0 then
            setFarmTargets(data.FarmDropdown)
            pcall(function()
                local sel = {}
                for _, v in ipairs(data.FarmDropdown) do sel[v] = true end
                FarmDropdown:Set(sel)
            end)
        end

        -- Alive Dropdown — values may not be loaded yet, retry until they appear
        if type(data.AliveDropdown) == "table" and #data.AliveDropdown > 0 then
            aliveTargets = data.AliveDropdown
            task.spawn(function()
                -- wait until AliveDropdown has values (max 10s)
                local deadline = os.clock() + 10
                while os.clock() < deadline do
                    local vals = AliveDropdown.Values or {}
                    if #vals > 0 then break end
                    task.wait(0.2)
                end
                pcall(function()
                    local sel = {}
                    for _, v in ipairs(data.AliveDropdown) do sel[v] = true end
                    AliveDropdown:Set(sel)
                end)
            end)
        end

        -- Chest Dropdown (multi → Set with table)
        if type(data.ChestDropdown) == "table" and #data.ChestDropdown > 0 then
            chestTargets = data.ChestDropdown
            pcall(function()
                local sel = {}
                for _, v in ipairs(data.ChestDropdown) do sel[v] = true end
                ChestDropdown:Set(sel)
            end)
        end
    end)
end

-- Load on startup
-- Set ค่า default ให้ slider ทุกตัวก่อน แล้วค่อย Load ทับ
-- วิธีนี้ป้องกัน library clamp(nil) เพราะ slider มีค่าอยู่แล้วก่อน Load
task.spawn(function()
    -- รอ 1 frame ให้ UI render เสร็จก่อน
    task.wait(0)

    -- set default ทุกตัวที่อาจไม่มีใน config เก่า
    pcall(function() FastAnimSpeedSlider:Set(5)  end)
    pcall(function() OpHitboxMultSlider:Set(3)   end)
    pcall(function() OpHarvestMultSlider:Set(3)  end)

    -- Load ทับ (ถ้า key มีใน json ก็จะ override ค่า default)
    pcall(function() myConfig:Load() end)

    -- clamp หลัง load เผื่อได้ค่าผิดปกติมา
    if not fastAnimSpeed or fastAnimSpeed < 1 then fastAnimSpeed = 5 end
    if not opHitboxMult  or opHitboxMult  < 1 then opHitboxMult  = 3 end
    if not opHarvestMult or opHarvestMult < 1 then opHarvestMult = 3 end

    task.delay(1, loadDropdowns)
end)

-- Auto-save every 10 seconds
task.spawn(function()
    while true do
        task.wait(10)
        pcall(function() myConfig:Save() end)
        saveDropdowns()
    end
end)

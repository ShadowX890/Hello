local function eatFood(foodId)
    if not VitualRemote or not foodId or foodId == "" then return false end

    -- 1. ถ้ายังไม่อยู่ใน hotbar → ย้ายเข้า hotbar ก่อน
    local hotbarSlot = findItemInHotbar(foodId)
    if not hotbarSlot then
        local moved = moveItemToHotbar(foodId, true)
        if not moved then return false end
        task.wait(0.3)
        hotbarSlot = findItemInHotbar(foodId)
        if not hotbarSlot then return false end
    end

    -- 2. เช็คว่าถืออยู่แล้วไหม
    local alreadyEquipped = false
    if Hotbar then
        local eqSlot = Hotbar:GetAttribute("EquippedSlot") or 0
        if eqSlot > 0 then
            local invSlotNum = Hotbar:GetAttribute("Slot" .. eqSlot)
            if invSlotNum and invSlotNum > 0 then
                local id = Inventory and Inventory:GetAttribute("Slot" .. invSlotNum .. "_ItemId")
                alreadyEquipped = id and normalizeId(id) == normalizeId(foodId)
            end
        end
    end

    if not alreadyEquipped then
        pcall(function()
            ItemAPIRemote:FireServer(buildUseHotbarBuffer(hotbarSlot), {})
        end)
        task.wait(0.3)
    end

    -- 3. กิน
    pcall(function()
        VitualRemote:FireServer(buildEatFoodBuffer(), {})
    end)
    task.wait(0.2)
    return true
end


-- ── Navigation ────────────────────────────────────────────────
-- Hardcoded coordinates broke when the map gained new biomes, so destinations
-- are read from the map itself: workspace.Map.Prop.BiomeProps.<Biome>.<Prop>
-- Each biome folder holds landmark props (Graveyard, Ruins2, Castle, ...).
local biomeSelected = nil
local biomePropList = {}     -- display label -> Instance
local biomeLabels   = {}     -- sorted labels for the dropdown

local function biomePropsFolder()
    local map  = workspace:FindFirstChild("Map")
    local prop = map and map:FindFirstChild("Prop")
    return prop and prop:FindFirstChild("BiomeProps")
end

-- position of a prop, whether it is a Part, a Model, or a folder of parts
local function propPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    local ok, pivot = pcall(function() return obj:GetPivot().Position end)
    if ok and typeof(pivot) == "Vector3" and pivot.Magnitude > 0.01 then
        return pivot
    end
    local part = obj:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

-- Walk each biome folder and keep whatever has a usable position.
-- Some props nest one deeper (MagicForest.Castle.Castle), so recurse a little.
local function collectBiomeProps()
    local list, labels = {}, {}
    local root = biomePropsFolder()
    if not root then return list, labels end

    local function addProp(biome, obj, depth)
        if depth > 2 then return end
        local pos = propPosition(obj)
        if pos then
            local label = biome .. " - " .. obj.Name
            if not list[label] then
                list[label] = obj
                labels[#labels + 1] = label
            end
            return
        end
        -- no position of its own: look inside (folder wrapping the real prop)
        for _, child in ipairs(obj:GetChildren()) do
            addProp(biome, child, depth + 1)
        end
    end

    for _, biome in ipairs(root:GetChildren()) do
        for _, obj in ipairs(biome:GetChildren()) do
            addProp(biome.Name, obj, 1)
        end
    end

    table.sort(labels)
    return list, labels
end

local function refreshBiomeProps()
    biomePropList, biomeLabels = collectBiomeProps()
    return biomeLabels
end


-- ═══════════════════════════════════════════════════
local chestEnabled     = false
local chestTargets     = {}
local chestDelay       = 1       -- วิ — หน่วงหลังเปิดแต่ละกล่องก่อนไปกล่องถัดไป
local _chestRemoteWarned  = false  -- กัน spam warn เวลา remote หาย
local _chestNetIdWarned   = false  -- กัน spam warn เวลาหา netId ไม่เจอ
-- ─── ตรวจว่ากล่องนี้เปิดไปแล้วหรือยัง ───────────────
local function isChestOpen(obj)
    if not obj or not obj.Parent then return true end  -- หายไปแล้ว = เปิดแล้ว
    local animCfg = obj:FindFirstChild("ChestAnimConfig")
    if not animCfg then return false end
    -- เช็ค IsOpen (client-side flag)
    local isOpen = animCfg:GetAttribute("IsOpen")
    if isOpen == true then return true end
    -- เช็ค ChestConfig สำหรับ BlewUp และ Roll
    local chestCfg = obj:FindFirstChild("ChestConfig")
    if chestCfg then
        if chestCfg:GetAttribute("_BlewUpOpened") == true then return true end
        if chestCfg:GetAttribute("_BlewUpEmpty")  == true then return true end
        if chestCfg:GetAttribute("_RollChestOpened") == true then return true end
    end
    return false
end

-- ดึง respawn time ที่เหลือของกล่อง (วิ) จาก attribute
local function getChestRespawnSecondsLeft(obj)
    if not obj or not obj.Parent then return nil end
    local respawnAt = obj:GetAttribute("_SetupChestRespawnAt")
    if not respawnAt then return nil end
    local left = respawnAt - os.time()
    return left > 0 and left or 0
end

-- ดึง ChestKind จาก preset
local chestKindCache = {}
local function getChestKind(obj)
    if not obj then return nil end
    local bn = baseName(obj.Name)
    if chestKindCache[bn] then return chestKindCache[bn] end
    local preset = obj:GetAttribute("_SetupChestPreset") or obj:GetAttribute("ChestPreset")
    if preset then
        if preset:find("Roll") then chestKindCache[bn] = "Roll"
        elseif preset:find("BlewUp") then chestKindCache[bn] = "BlewUp" end
        return chestKindCache[bn]
    end
    -- fallback by name
    if bn:find("Golden") or bn:find("Supreme") then return "Roll" end
    return "BlewUp"
end

-- เช็ค ItemRequire ของกล่อง (เช่น Golden ต้องใช้ COIN 100)
local function canOpenChest(obj)
    if not obj then return false end
    local chestCfg = obj:FindFirstChild("ChestConfig")
    if not chestCfg then return true end
    local reqId  = chestCfg:GetAttribute("_ItemRequireId")
    local reqAmt = chestCfg:GetAttribute("_ItemRequireAmount")
    if not reqId or not reqAmt then return true end
    -- เช็คว่ามีของพอใน Inventory
    if not Inventory then return true end
    local normReq = normalizeId(reqId)
    local maxSlots = Inventory:GetAttribute("MaxSlots") or 64
    local total = 0
    for i = 1, maxSlots do
        local id  = Inventory:GetAttribute("Slot"..i.."_ItemId")
        local qty = Inventory:GetAttribute("Slot"..i.."_Amount") or 0
        if id and normalizeId(id) == normReq then
            total += qty
        end
    end
    return total >= reqAmt
end

-- ─── Float lock: ล็อค position ลอยอยู่กับที่ (velocity=0) ───
local chestFloating    = false
local chestFloatTarget = nil

local function startFloatLock(pos)
    chestFloatTarget = pos
    chestFloating = true
    task.spawn(function()
        while chestFloating do
            local root = getRoot()
            if root then
                root.CFrame = CFrame.new(chestFloatTarget)
                root.AssemblyLinearVelocity  = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            task.wait(0)
        end
    end)
end

local function stopFloatLock()
    chestFloating = false
    chestFloatTarget = nil
    -- land safely
    local root = getRoot()
    if root then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = { Character }
        local hit = workspace:Raycast(root.Position, Vector3.new(0, -500, 0), rayParams)
        local groundY = hit and (hit.Position.Y + 3) or root.Position.Y
        root.CFrame = CFrame.new(root.Position.X, groundY, root.Position.Z)
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

-- ═══════════════════════════════════════════════════
--  CHEST netId + buffer (ยืนยันจาก remote spy: กด E ที่หีบ)
--  client จริงยิง buffer เดียว: chestNetId={uuid}, op=CHEST_ANIM_OPEN
-- ═══════════════════════════════════════════════════
local UUID_PATTERN = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
local netIdCache = {}

local function looksLikeUUID(v)
    return type(v) == "string" and v:match(UUID_PATTERN) ~= nil
end

local function scanAttributesForUUID(inst)
    if not inst then return nil end
    local ok, attrs = pcall(function() return inst:GetAttributes() end)
    if not ok or type(attrs) ~= "table" then return nil end
    -- ให้ความสำคัญกับ key ที่มีคำว่า net/id/uuid ก่อน
    for k, v in pairs(attrs) do
        local lk = tostring(k):lower()
        if (lk:find("net") or lk:find("uuid") or lk:find("guid")) and looksLikeUUID(v) then
            return v
        end
    end
    for _, v in pairs(attrs) do
        if looksLikeUUID(v) then return v end
    end
    return nil
end

-- หา netId (UUID) ของหีบให้ได้แน่ๆ — ถ้าได้ผิด/ไม่ได้ = เปิดไม่ได้เลย
local function getChestNetId(obj)
    if not obj then return nil end
    if netIdCache[obj] then return netIdCache[obj] end
    -- 1) ชื่อ attribute ที่น่าจะเป็นไปได้
    local candidates = {
        "ModelNetId", "NetId", "ChestNetId", "_ChestNetId", "chestNetId",
        "_NetId", "NetworkId", "Guid", "GUID", "Uuid", "UUID", "Id", "ID",
    }
    for _, name in ipairs(candidates) do
        local v = obj:GetAttribute(name)
        if looksLikeUUID(v) then netIdCache[obj] = v; return v end
    end
    -- 2) สแกน attribute ทั้งหมดบนตัว model
    local v = scanAttributesForUUID(obj)
    if v then netIdCache[obj] = v; return v end
    -- 3) สแกนใน child config ที่เกี่ยวข้อง
    for _, childName in ipairs({ "ChestConfig", "ChestAnimConfig" }) do
        local cv = scanAttributesForUUID(obj:FindFirstChild(childName))
        if cv then netIdCache[obj] = cv; return cv end
    end
    -- 4) fallback: ModelNetId ที่อาจไม่ใช่รูปแบบ UUID เป๊ะ
    local raw = obj:GetAttribute("ModelNetId")
    if type(raw) == "string" and raw ~= "" then
        netIdCache[obj] = raw; return raw
    end
    return nil
end

-- สร้าง buffer แบบเดียวกับ client จริง (byte array + writeu8)
-- payload length = 38 + #netId (uuid 36 -> 74 = 0x4A ตรงกับ spy)
local function makeChestOpenBuffer(netId)
    if not netId or netId == "" then return nil end
    local KEY1 = "chestNetId"        -- len 10
    local OP   = "CHEST_ANIM_OPEN"   -- len 15
    local bytes = { 241, 67, (38 + #netId) % 256, 0, 0, 2, 9, 7, #KEY1 }
    for i = 1, #KEY1 do bytes[#bytes + 1] = string.byte(KEY1, i) end
    bytes[#bytes + 1] = 7
    bytes[#bytes + 1] = #netId
    for i = 1, #netId do bytes[#bytes + 1] = string.byte(netId, i) end
    bytes[#bytes + 1] = 7; bytes[#bytes + 1] = 2
    bytes[#bytes + 1] = string.byte("o"); bytes[#bytes + 1] = string.byte("p")
    bytes[#bytes + 1] = 7; bytes[#bytes + 1] = #OP
    for i = 1, #OP do bytes[#bytes + 1] = string.byte(OP, i) end
    bytes[#bytes + 1] = 10
    local ok, buf = pcall(function()
        local b = buffer.create(#bytes)
        for i = 1, #bytes do buffer.writeu8(b, i - 1, bytes[i]) end
        return b
    end)
    return ok and buf or nil
end

-- ═══════════════════════════════════════════════════
--  LOOT CHEST — ดึงของในหีบเข้ากระเป๋าโดยตรง (เหมือนปุ่ม "Loot All")
--  ยืนยันจาก LocalChestUI:
--    v1:FireServer({ op="LOOT_CHEST", toInvSlot=0, chestNetId=id,
--                    slotIndex=i, amount=n })   (v1 = NetRay itemAPI_service)
--  ของเก็บอยู่ใน ChestConfig เป็น attribute Slot{i}_ItemId / Slot{i}_Amount
-- ═══════════════════════════════════════════════════
local function lootChestAll(obj, netId)
    if not obj or not obj.Parent or not netId or netId == "" then return false end
    local cfg = obj:FindFirstChild("ChestConfig")
    if not cfg then return false end
    local ev = getItemEvent()
    if not ev then return false end
    local maxSlots = cfg:GetAttribute("MaxSlots") or 32
    local looted = false
    for i = 1, maxSlots do
        local itemId = cfg:GetAttribute(("Slot%d_ItemId"):format(i))
        local amt    = cfg:GetAttribute(("Slot%d_Amount"):format(i))
        if type(itemId) == "string" and itemId ~= "" and type(amt) == "number" and amt > 0 then
            pcall(function()
                ev:FireServer({
                    op         = "LOOT_CHEST",
                    toInvSlot  = 0,          -- 0 = ให้เกมหาช่องว่างเอง
                    chestNetId = netId,
                    slotIndex  = i,
                    amount     = amt,
                })
            end)
            looted = true
        end
    end
    return looted
end

-- ── ตรวจกระเป๋าเต็ม + ข้อยกเว้น COIN ─────────────────
-- COIN สะสมได้ไม่จำกัด (MaxStack 9999) จึงเก็บได้เสมอแม้กระเป๋าเต็ม
local function isCoinName(name)
    return type(name) == "string" and name:upper():find("COIN") ~= nil
end

local function invIsFull()
    if not Inventory then return false end
    local maxSlots = Inventory:GetAttribute("MaxSlots") or 32
    local used = 0
    for i = 1, maxSlots do
        local id = Inventory:GetAttribute("Slot" .. i .. "_ItemId")
        if type(id) == "string" and id ~= "" then used += 1 end
    end
    return used >= maxSlots
end

-- ควรเก็บ drop ชิ้นนี้ไหม? เต็มแล้วเก็บเฉพาะ COIN
local function shouldCollectDrop(itemObj)
    if isCoinName(baseName(itemObj.Name)) then return true end  -- coin เก็บได้เสมอ
    return not invIsFull()                                       -- ของอื่น: เฉพาะตอนยังไม่เต็ม
end

-- เก็บของที่หีบดรอปลงพื้นรอบๆ ตำแหน่งหีบ เข้ากระเป๋าทันที
-- บังคับเก็บทุกชิ้น (ไม่สนใจ dropdown Auto Collect) เพราะเป็นลูทจากหีบ
-- รวมมากับ Auto Open เลย ไม่ต้องเปิด Auto Collect แยก
-- ยกเว้น: ถ้ากระเป๋าเต็ม จะเก็บเฉพาะ COIN
local function collectChestDrops(centerPos, radius)
    if not ItemsFolder or not centerPos then return end
    radius = radius or 50
    -- กวาดหลายรอบสั้นๆ เผื่อของทยอยหล่นหลังเปิด/หลัง animation
    for _ = 1, 4 do
        if not chestEnabled then break end
        local any = false
        for _, it in ipairs(ItemsFolder:GetChildren()) do
            if not chestEnabled then break end
            if it and it.Parent then
                local p = getObjPos(it)
                if p and (centerPos - p).Magnitude <= radius then
                    if shouldCollectDrop(it) then
                        any = true
                        collectItemForce(it)
                    end
                end
            end
        end
        if not any then break end
        task.wait(0.15)
    end
end

local function openChest(obj)
    if not obj or not obj.Parent then return end
    local pos = getObjPos(obj)
    if not pos then return end

    -- ดึง netId แบบแข็งแรง (ลองหลายชื่อ + สแกน attribute)
    local netId = getChestNetId(obj)
    if not netId or netId == "" then
        -- หา netId ไม่เจอ = เปิดไม่ได้ แจ้งครั้งเดียวเพื่อ debug
        if not _chestNetIdWarned then
            _chestNetIdWarned = true
            pcall(function()
                warn("[AutoChest] netId not found on chest:", obj.Name,
                     "-- attributes:", obj:GetAttributes())
            end)
        end
        return
    end

    -- วาปเข้าไปใกล้กล่อง
    local hinge = obj:FindFirstChild("Hinge")
    local targetPos = hinge and hinge.Position or pos
    local root = getRoot()
    if root then
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 4))
    end
    task.wait(0.3)

    startFloatLock(targetPos + Vector3.new(0, 4, 0))

    -- สร้าง buffer แบบเดียวกับ client จริง (ยืนยันจาก remote spy)
    local rawBuf = makeChestOpenBuffer(netId)

    -- ยิงจนเปิด หรือ timeout 6 วิ — ถ้าไม่ได้ก็ออกไปเลย
    local opened = false
    local maxTime = os.clock() + 6
    while obj.Parent and os.clock() < maxTime do
        if not chestEnabled then break end
        if isChestOpen(obj) then opened = true; break end
        if rawBuf and ItemAPIRemote then
            pcall(function() ItemAPIRemote:FireServer(rawBuf, {}) end)
        elseif not ItemAPIRemote and not _chestRemoteWarned then
            -- remote สำหรับเปิดหีบหาไม่เจอ -> เปิดไม่ได้แน่นอน แจ้งครั้งเดียว
            _chestRemoteWarned = true
            pcall(function()
                if WindUI then
                    WindUI:Notify({
                        Title = "Auto Chest",
                        Content = "itemAPI_service remote not found — cannot open chests.",
                        Duration = 5,
                        Icon = "alert-circle",
                    })
                end
                warn("[AutoChest] ItemAPIRemote (itemAPI_service) is nil")
            end)
        end
        task.wait(0.5)
    end
    if isChestOpen(obj) then opened = true end

    -- รอ animation + loot drop ตาม ChestKind
    if opened then
        local kind = getChestKind(obj)
        local animCfg = obj:FindFirstChild("ChestAnimConfig")
        if animCfg then
            -- รอ Busy = false
            local waitBusy = os.clock() + (kind == "Roll" and 8 or 5)
            while obj.Parent and os.clock() < waitBusy do
                if animCfg:GetAttribute("Busy") == false then break end
                task.wait(0.1)
            end
            -- ลูททันทีที่เปิดเสร็จ (ช่องของถูกเติมแล้ว) ก่อนหีบปิดอัตโนมัติ
            lootChestAll(obj, netId)
            local tweenTime  = animCfg:GetAttribute("TweenTime")      or 0.8
            local closeDelay = animCfg:GetAttribute("AutoCloseDelay")  or 1.25
            -- Roll chest (Golden/Supreme) มี RollDuration = 5 วิ
            local rollExtra  = (kind == "Roll") and 5 or 0
            task.wait(tweenTime + closeDelay + rollExtra + 0.3)
            lootChestAll(obj, netId)   -- ลูทซ้ำเผื่อช่องเพิ่งเติมหลัง roll
        else
            -- fallback
            task.wait(kind == "Roll" and 7 or 2.5)
            lootChestAll(obj, netId)
        end
    end

    -- หยุด float lock เสมอ ไม่ว่าจะเกิดอะไรขึ้น
    stopFloatLock()

    -- เก็บลูทที่หีบดรอปลงพื้นเข้ากระเป๋าทันที (ทำงานร่วมกับ Auto Open เลย)
    collectChestDrops(targetPos, 55)
end


-- track chests we recently tried — เป็น cooldown ตามเวลา (ไม่ blacklist ถาวร)
-- ทำให้หีบที่ respawn กลับมาเปิดได้อีก และหีบที่เปิดพลาดถูกลองใหม่
local chestCooldown = {}       -- [obj] = os.clock() ตอนลองล่าสุด
local CHEST_RETRY_CD = 8       -- วิ ก่อนจะลองหีบเดิมอีกครั้ง

-- ── shared helper: drain ItemsFolder (single pass) ───
-- ไม่วนซ้ำรอจนว่าง เพื่อไม่ block auto alive
local function drainItems(collectMode)
    if not ItemsFolder then return end
    collectMode = collectMode or "selected"
    local queue = ItemsFolder:GetChildren()
    if #queue == 0 then return end
    for _, obj in ipairs(queue) do
        local stillActive = (collectMode == "all") and autoCollectAllEnabled or itemsEnabled
        if not stillActive then return end
        if not obj or not obj.Parent then continue end
        if collectMode == "all" then
            collectItemForce(obj)
        else
            collectItem(obj)
        end
    end
end

local function drainItemsAny()
    if not ItemsFolder or #ItemsFolder:GetChildren() == 0 then return end
    if autoCollectAllEnabled then
        drainItems("all")
    elseif itemsEnabled then
        drainItems("selected")
    end
end

-- ── helper: run one pass of alive farming ──
local function runAlive()
    if not AliveFolder then return end
    local found = true
    while found and aliveEnabled and not isEatingPause and not isSafeHpPause do
        found = false
        for _, obj in ipairs(AliveFolder:GetChildren()) do
            if not aliveEnabled or isEatingPause or isSafeHpPause then break end
            if not isAlive(obj) then continue end
            local hit = false
            if aliveUseRange then
                hit = distanceTo(obj) <= aliveRange
            else
                local bn = baseName(obj.Name)
                for _, sel in ipairs(aliveTargets) do
                    if sel == bn then hit = true; break end
                end
            end
            if hit then
                found = true
                killTarget(obj)
                -- เก็บของที่ดรอปจาก mob ตัวนี้ก่อน แล้วค่อยไปตัวถัดไป
                -- (ทำงานเฉพาะเมื่อเปิด Auto Collect / Collect All อยู่)
                drainItemsAny()
                break
            end
        end
    end
end


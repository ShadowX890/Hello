--  AUTO FARM ALIVE
-- ═══════════════════════════════════════════════════
local aliveEnabled    = false
local aliveAllEnabled = false  -- ฆ่าทุก mob ใน AliveFolder โดยไม่สนใจ dropdown/range
local aliveTargets  = {}
local aliveDelay    = 0.2
local aliveAbove    = 5
local aliveRange    = 100
local aliveUseRange = false  -- true = kill all in range | false = use dropdown targets

-- ── Ranged weapon support (Bow / Crossbow / Staff / Spell) ──
-- อาวุธระยะไกลต้อง "เล็ง(aim) แล้วยิง" ไม่ใช่ถือ M1 ค้างเหมือน melee
-- และทิศยิงมาจากทิศ "กล้อง" -> ต้องหมุนกล้องไปที่เป้าก่อนยิง
local rangedAimEnabled = false   -- toggle: เปิดโหมดเล็งยิงระยะไกล
local rangedDelay      = 0.35    -- วิ ระหว่างการยิงแต่ละนัด
local _rangedActive    = false   -- true = กำลังยิง ranged ใส่เป้าปัจจุบัน (ให้ hover-lock หมุนกล้อง)

-- Auto Safe HP (ใช้ใน Farm Alive)
local safeHpEnabled   = false
local safeHpThreshold = 50    -- % ที่จะหนี
local safeHoverHeight = 15    -- studs เหนือพื้น (พอหลบ mob ไม่สูงจนเกิน render)
local isSafeHpPause   = false -- true = กำลังรอ regen อยู่

local AliveFolder = workspace:FindFirstChild("Alive")
task.spawn(function()
    if not AliveFolder then
        AliveFolder = workspace:WaitForChild("Alive", 60)
    end
end)

-- Get all player names to exclude from alive list
local function getPlayerNames()
    local names = {}
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        names[p.Name] = true
    end
    return names
end

local function isPlayerCharacter(obj)
    -- check if this object is a player's character
    local playerNames = getPlayerNames()
    -- exact name match with any player
    if playerNames[obj.Name] then return true end
    -- has Humanoid with a player's UserId attribute
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
            if p.Character == obj then return true end
        end
    end
    return false
end

local function getUniqueAliveNames()
    local seen, list = {}, {}
    pcall(function()
        for _, obj in ipairs(AliveFolder:GetChildren()) do
            -- only skip if this is actually a player's character (by reference, not name)
            local isPlayer = false
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if p.Character == obj then isPlayer = true; break end
            end
            if isPlayer then continue end
            local bn = baseName(obj.Name)
            if bn ~= "" and not seen[bn] then
                seen[bn] = true
                table.insert(list, bn)
            end
        end
    end)
    table.sort(list)
    return list
end

-- Check if target is still alive (removed from folder = dead)
local currentAliveTarget = nil
-- true ระหว่างที่ hover-lock coroutine ยังทำงาน/กำลังลงพื้น
-- ใช้กันไม่ให้ landing teleport ไปชนกับการวาปเก็บของ
local hoverLockActive = false

-- Check if target is still alive:
-- 1) still in folder (Parent exists)
-- 2) Humanoid health > 0  (if readable)
-- 3) not invisible / fully transparent (fallback visibility check)
local function isAlive(obj)
    if not obj or not obj.Parent then return false end
    -- never attack player characters
    if isPlayerCharacter(obj) then return false end
    -- skip tamed mobs (has Owner or OwnerUserId attribute)
    if obj:GetAttribute("Owner") ~= nil then return false end
    if obj:GetAttribute("OwnerUserId") ~= nil then return false end
    -- check Humanoid health if available
    local hum = obj:FindFirstChildWhichIsA("Humanoid", true)
    if hum then
        if hum.Health <= 0 then return false end
    end
    -- fallback: treat fully-transparent or size-zero part as dead/gone
    local bp = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
    if bp and bp.Transparency >= 1 then return false end
    return true
end

-- Zero out root velocity to prevent bouncing/launching
local function resetVelocity()
    local root = getRoot()
    if root and root:IsA("BasePart") then
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

-- Hover lock: re-lock CFrame every frame so player never falls
-- When lock ends, land the player safely on the ground
local function startHoverLock(obj)
    hoverLockActive = true
    task.spawn(function()
        while currentAliveTarget == obj and isAlive(obj) and (aliveEnabled or aliveAllEnabled) and not isEatingPause and not isSafeHpPause do
            local pos = getObjPos(obj)
            local root = getRoot()
            if pos and root then
                local stayPos = pos + Vector3.new(0, aliveAbove, 0)
                root.CFrame = CFrame.new(stayPos, pos)
                -- ยิงระยะไกล: หมุนกล้องเล็งไปที่เป้า (BuildPacket ใช้ทิศกล้อง)
                if _rangedActive then
                    local cam = workspace.CurrentCamera
                    if cam then
                        pcall(function()
                            cam.CFrame = CFrame.new(stayPos, pos)
                        end)
                    end
                end
            end
            task.wait(0)
        end
        -- Lock ended: zero velocity then raycast down to land safely
        resetVelocity()
        task.wait(0)
        local root = getRoot()
        if root then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = { Character }
            local hit = workspace:Raycast(root.Position, Vector3.new(0, -500, 0), rayParams)
            local groundY = hit and (hit.Position.Y + 3) or (root.Position.Y - aliveAbove)
            root.CFrame = CFrame.new(root.Position.X, groundY, root.Position.Z)
            resetVelocity()
        end
        hoverLockActive = false   -- landing เสร็จแล้ว ปลอดภัยที่จะวาปเก็บของต่อ
    end)
end

-- Require LocalCombat directly -- same module the game uses for M1
local LocalCombat = nil
pcall(function()
    LocalCombat = require(
        game:GetService("ReplicatedStorage")
            .Modules.Player_Node.LocalModule
            :FindFirstChild("LocalCombat")  -- ใช้ FindFirstChild แทน WaitForChild เพื่อไม่บล็อกใน Lobby
    )
end)

-- Call M1() directly without touching mouse at all (melee)
local function doSwing(obj)
    if not aliveEnabled and not aliveAllEnabled then return end
    if not LocalCombat then return end
    pcall(function()
        if LocalCombat.SetM1Held then LocalCombat.SetM1Held(true) end
        LocalCombat.M1()
    end)
end

-- ── Ranged: ตรวจว่าอาวุธที่ถืออยู่เป็นระยะไกลไหม ──
-- ใช้ StartAim() แล้วเช็ค IsAimMode(): เกมจะเข้า aim ได้เฉพาะอาวุธ ranged
-- (CanEnterAim ผ่านเฉพาะ Bow/Crossbow/Staff/Spell) -> ตรวจได้แม่นโดยไม่ต้องเดา
local function isRangedWeaponReady()
    if not LocalCombat then return false end
    local ok = false
    pcall(function()
        if LocalCombat.StartAim then LocalCombat.StartAim() end
    end)
    pcall(function()
        ok = LocalCombat.IsAimMode and LocalCombat.IsAimMode() == true
    end)
    if not ok then
        pcall(function() if LocalCombat.StopAim then LocalCombat.StopAim() end end)
    end
    return ok
end

-- ยิงระยะไกล 1 นัด: อยู่ใน aim mode แล้ว FireRangedFromAim จะ hold->fire ให้เอง
local function doRangedShot(obj)
    if not LocalCombat then return end
    pcall(function()
        if not (LocalCombat.IsAimMode and LocalCombat.IsAimMode()) then
            if LocalCombat.StartAim then LocalCombat.StartAim() end
        end
        if LocalCombat.FireRangedFromAim then LocalCombat.FireRangedFromAim() end
    end)
end

-- ปิด aim + ปล่อย M1 ให้เรียบร้อย (เรียกตอนเลิกยิง)
local function stopRanged()
    _rangedActive = false
    pcall(function()
        if LocalCombat then
            if LocalCombat.StopAim   then LocalCombat.StopAim() end
            if LocalCombat.M1Release then LocalCombat.M1Release() end
        end
    end)
end

-- Kill one target: hover-lock + swing/shoot until dead
local function killTarget(obj)
    currentAliveTarget = obj
    -- ตัดสินใจว่าจะใช้ ranged ไหม (เปิด toggle + ถืออาวุธระยะไกลอยู่)
    local useRanged = rangedAimEnabled and isRangedWeaponReady()
    _rangedActive = useRanged
    startHoverLock(obj)
    while isAlive(obj) and (aliveEnabled or aliveAllEnabled) do
        if useRanged then doRangedShot(obj) else doSwing(obj) end
        task.wait(useRanged and rangedDelay or aliveDelay)
    end
    if useRanged then stopRanged() end
    currentAliveTarget = nil
    -- รอให้ hover-lock ลงพื้นเสร็จก่อน (timeout 1 วิ) เพื่อไม่ให้
    -- landing teleport ไปชนกับการวาปเก็บของ -> ต้นเหตุที่ทำให้ไม่เสถียร
    local _landDeadline = os.clock() + 1
    while hoverLockActive and os.clock() < _landDeadline do
        task.wait(0)
    end
end

-- alive loop handled in unified loop below

-- ═══════════════════════════════════════════════════
--  AUTO SPECIAL / AWAKEN (ใช้สกิลพิเศษ/ปลุกพลังตอนสู้)
--  UseSpecial / UseBeastMasterAwake มีการเช็คเงื่อนไขในตัวแล้ว
--  (คูลดาวน์, คลาส, AwakenBar) เรียกซ้ำได้ปลอดภัย
-- ═══════════════════════════════════════════════════
local autoSpecialEnabled = false
local autoAwakenEnabled   = false
local specialKey          = "R"     -- ปุ่มสกิลพิเศษ (R/Q/E/F/Z/X/C)

task.spawn(function()
    while true do
        if not LocalCombat then task.wait(IDLE_WAIT) continue end
        task.wait(0.4)
        if not (autoSpecialEnabled or autoAwakenEnabled) then continue end
        -- ยิงสกิลเฉพาะตอนกำลังสู้ (มีเป้าใน Farm Alive) เพื่อไม่ให้เปลืองสกิล
        local inCombat = (aliveEnabled or aliveAllEnabled) and currentAliveTarget ~= nil
        if not inCombat then continue end
        if autoSpecialEnabled then
            pcall(function()
                if LocalCombat.UseSpecial then LocalCombat.UseSpecial(specialKey) end
            end)
        end

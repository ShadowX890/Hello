MainTab:Button({
    Title = "Go Home",
    Desc  = "loc:DSC_073",
    Icon  = "navigation",
    Callback = function()
        if not BuildParts then
            WindUI:Notify({ Title = "Go Home", Content = "Not available in Lobby.", Duration = 3, Icon = "info" })
            return
        end
        local core = BuildParts:FindFirstChild("Core")
        if not core then
            -- ลอง WaitForChild สั้นๆ กัน race
            local ok, result = pcall(function()
                return BuildParts:WaitForChild("Core", 3)
            end)
            if ok and result then core = result end
        end
        if not core then return end
        local corePos = getObjPos(core)
        if corePos then
            -- คำนวณขนาดของ Core เพื่อวาปข้างๆ ไม่ทับ
            local offset = 8  -- studs ห่างออกจากขอบโมเดล
            local size = Vector3.new(0, 0, 0)
            if core:IsA("Model") and core.PrimaryPart then
                size = core.PrimaryPart.Size
            elseif core:IsA("BasePart") then
                size = core.Size
            end
            local halfZ   = (size.Z / 2) + offset
            local root    = getRoot()
            if not root then return end
            -- วาปมาด้านหน้าของ Core (ทิศ +Z) ยืนข้างๆ
            root.CFrame = CFrame.new(
                corePos + Vector3.new(0, 4, halfZ)
            )
        end
    end,
})


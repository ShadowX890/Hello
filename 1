-- ── Swing payload builder ─────────────────────────────────────
-- UserInput routes M1 through LocalCombat, which sends an incrementing swingId
-- and a cycling comboIdx (captures show swingId 2 .. 1339, comboIdx 1 and 3).
-- Repeating one fixed id every swing looks wrong to the server, so mirror it.
local swingCounter = math.random(20, 400)
local comboCounter = 0
local COMBO_MAX    = 3

-- the tool the character actually has out (Character attributes set by the game)
local function equippedToolInfo()
    local char = LocalPlayer and LocalPlayer.Character
    if not char then return nil, nil end
    local tType = char:GetAttribute("ToolType")
    local tName = char:GetAttribute("ToolEquipped") or char:GetAttribute("ToolEquppied")
    if type(tType) ~= "string" or tType == "" then tType = nil end
    if type(tName) ~= "string" or tName == "" then tName = nil end
    return tType, tName
end

-- build one harvest payload for an object, using the real equipped tool when known
local function buildSwing(cfg, obj)
    swingCounter = swingCounter + 1
    comboCounter = comboCounter % COMBO_MAX + 1

    local tType, tName = equippedToolInfo()
    return {
        toolType     = tType or cfg.toolType,
        comboIdx     = comboCounter,
        swingId      = swingCounter,
        mode         = "harvest",
        equipped     = tName or cfg.equipped,
        objectTarget = obj,
    }
end

-- ตรวจ Durability: nil = ไม่มี attribute ถือว่ายังอยู่, 0 = ตายแล้ว
local function getDurability(obj)
    return obj:GetAttribute("Durability")
end

-- ═══════════════════════════════════════════════════
--  TARGET CACHE
--  Walking the whole Natural tree every cycle is what caused the FPS drops
--  (SnowyLoad alone holds hundreds of nodes). Scan on a timer instead and
--  reuse the result; the fire loop then only does a cheap distance test.
-- ═══════════════════════════════════════════════════
local RESCAN_EVERY   = 1.0     -- seconds between full tree scans
local SCAN_PAD       = 120     -- keep nodes a bit outside range so walking still works
local MAX_TARGETS    = 400     -- hard cap so a huge map can never stall a frame

local nodeCache, nodeCacheAt = {}, 0
local allCache,  allCacheAt  = {}, 0

-- collect harvest nodes near the player (folders only, never model internals)
local function collectNodes(root, out, wantFn, extraFilter, depth)
    if not root or (depth or 0) > 3 or #out >= MAX_TARGETS then return end
    for _, obj in ipairs(root:GetChildren()) do
        if #out >= MAX_TARGETS then return end
        if obj:IsA("Folder") then
            collectNodes(obj, out, wantFn, extraFilter, (depth or 0) + 1)
        elseif looksLikeNode(obj) then
            if not (extraFilter and not extraFilter(obj.Name)) then
                if wantFn(obj) and distanceTo(obj) <= farmRange + SCAN_PAD then
                    out[#out + 1] = obj
                end
            end
        end
    end
end

-- farmTargetSet mirrors farmTargets as a lookup table. Scanning the array for
-- every node was the spike you felt right after picking items in the dropdown.
local function isSelected(obj)
    return farmTargetSet[baseName(obj.Name)] == true
end

local function alwaysTrue() return true end

-- nearest first, so the per-cycle cap always spends its swings on close nodes
local function sortByDistance(list)
    pcall(function()
        table.sort(list, function(a, b)
            return distanceTo(a) < distanceTo(b)
        end)
    end)
    return list
end

local function refreshNodeCache()
    if os.clock() - nodeCacheAt < RESCAN_EVERY then return nodeCache end
    nodeCacheAt = os.clock()
    local out = {}
    pcall(function() collectNodes(Natural, out, isSelected, nil, 0) end)
    pcall(function() collectNodes(BuildParts, out, isSelected, isBuildFarmable, 0) end)
    nodeCache = sortByDistance(out)
    return nodeCache
end

local function refreshAllCache()
    if os.clock() - allCacheAt < RESCAN_EVERY then return allCache end
    allCacheAt = os.clock()
    local out = {}
    pcall(function() collectNodes(Natural, out, alwaysTrue, nil, 0) end)
    pcall(function() collectNodes(BuildParts, out, alwaysTrue, isBuildFarmable, 0) end)
    allCache = sortByDistance(out)
    return allCache
end

-- fire one cycle at every cached node that is alive and in range
local function swingAtCached(list, stillOn)
    local hit    = false
    local used   = 0
    local budget = opBurstMode and math.max(opMaxTargets, 1) or 1
    local swings = opBurstMode and math.max(opSwingsPerTick, 1) or 1

    for _, obj in ipairs(list) do
        if used >= budget then break end
        if not stillOn() or isEatingPause then break end
        if obj.Parent then
            local dur = getDurability(obj)
            if (dur == nil or dur > 0) and distanceTo(obj) <= farmRange then
                hit  = true
                used = used + 1
                local cfg = getToolConfig(baseName(obj.Name))
                for _ = 1, swings do
                    pcall(function()
                        HarvestRemote:FireServer(buildSwing(cfg, obj))
                    end)
                end
            end
        end
    end
    return hit
end

task.spawn(function()
    while true do
        if farmEnabled and #farmTargets > 0 then
            local found = swingAtCached(refreshNodeCache(), function() return farmEnabled end)
            if found then
                task.wait(math.max(farmDelay, 0))
            else
                nodeCacheAt = 0        -- nothing hit: allow an immediate rescan
                task.wait(0.4)
            end
        else
            task.wait(0.5)
        end
    end
end)

-- ─── Farm All (aura mode — ไม่สนใจ dropdown) ──────
local farmAllEnabled = false

task.spawn(function()
    while true do
        if not farmAllEnabled then
            task.wait(0.5)
            continue
        end
        local found = swingAtCached(refreshAllCache(), function() return farmAllEnabled end)
        if found then
            task.wait(math.max(farmDelay, 0))
        else
            allCacheAt = 0
            task.wait(0.4)
        end
    end
end)


-- ═══════════════════════════════════════════════════
--  AUTO ROOM  (lobby room gate)
--  The gate is server driven: touching it makes the server fire
--  GateRemote → "OpenRoomSettings" with the room's limits, then the client
--  answers with  FireServer("CreateRoom", roomName, modeKey, maxPlayers, slot).
--  Tutorial mode takes no size/slot:  ("CreateRoom", roomName, "Tutorial", 1)
-- ═══════════════════════════════════════════════════
local GateRemote = ReplicatedStorage:FindFirstChild("GateRemote")

local ROOM_MODES  = { "Normal", "Hard", "Tutorial" }
local ROOM_GATES  = { "Auto", "Room1", "Room2", "Room3", "Room4" }

local autoRoomEnabled = false
local roomMode        = "Normal"
local roomMaxPlayers  = 1
local roomSaveSlot    = 1
local roomGateChoice  = "Auto"

-- last payload the server sent us (nil until a gate is opened)
local roomInfo    = nil
local roomName    = nil
local roomStatus  = "Idle"
local roomBusy    = false
local roomDone    = false   -- true once we made / joined a room, so auto stops

-- Room gates only exist in the Lobby. Once the match map is loaded we are
-- inside a room and must not ask for another one.
local function inLobby()
    if workspace:FindFirstChild("Map") then return false end
    return workspace:FindFirstChild("Gate") ~= nil
end

-- ── Gate touching ─────────────────────────────────────────────
-- workspace.Gate.RoomN.Gate holds a TouchInterest, so firetouchinterest
-- opens the settings UI from anywhere — no walking to the door.
local function gatePart(name)
    local folder = workspace:FindFirstChild("Gate")
    local room   = folder and folder:FindFirstChild(name)
    local gate   = room and room:FindFirstChild("Gate")
    if gate and gate:IsA("BasePart") then return gate end
    return nil
end

local function listGates()
    local out = {}
    for _, n in ipairs(ROOM_GATES) do
        if n ~= "Auto" then
            local g = gatePart(n)
            if g then out[#out + 1] = { name = n, part = g } end
        end
    end
    return out
end

local function touchGate(gate)
    if typeof(firetouchinterest) ~= "function" then
        roomStatus = "Executor has no firetouchinterest"
        return false
    end
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChildWhichIsA("BasePart")
    if not gate or not hrp then return false end
    local ok = pcall(function()
        firetouchinterest(gate, hrp, 0)
        task.wait()
        firetouchinterest(gate, hrp, 1)
    end)
    return ok
end

-- ── World save slots ──────────────────────────────────────────
-- WorldSaveManage:FireServer("CreateSlot", worldName, seed)  -> server picks
--   the slot and replies ("SlotCreated", index, data)
-- WorldSaveManage:FireServer("DeleteSlot", index)            -> ("SlotDeleted", index)
-- Slot state lives at LocalPlayer.PlayerDataConfig.SaveSlotsData.Slot{N}
local WorldSaveManage = ReplicatedStorage:FindFirstChild("WorldSaveManage")

local autoSlotEnabled = true            -- make a slot first if the chosen one is empty
local slotWorldName   = "My World"
local slotSeed        = ""

local lastSlotCreated = nil             -- index the server handed back
local slotStatus      = "No slot action yet"

local function slotFolder()
    local cfg = LocalPlayer:FindFirstChild("PlayerDataConfig")
    return cfg and cfg:FindFirstChild("SaveSlotsData")
end

local function slotConfig(n)
    local f = slotFolder()
    return f and f:FindFirstChild("Slot" .. tostring(n))
end

-- an unused slot reads SavedAt = 0 / SaveID = "New World"
local function slotIsEmpty(n)
    local c = slotConfig(n)
    if not c then return true end
    local savedAt = tonumber(c:GetAttribute("SavedAt")) or 0
    local id      = tostring(c:GetAttribute("SaveID") or "")
    return savedAt == 0 or id == "New World" or id == ""
end

local function slotSummary()
    local f = slotFolder()
    if not f then return "Slot data not loaded" end
    local parts = {}
    for i = 1, 3 do
        local c = slotConfig(i)
        if c then
            local id  = tostring(c:GetAttribute("SaveID") or "New World")
            local day = tonumber(c:GetAttribute("Day")) or 0
            parts[#parts + 1] = slotIsEmpty(i)
                and ("%d: empty"):format(i)
                or  ("%d: %s (day %d)"):format(i, id, day)
        end
    end
    if #parts == 0 then return "No slots found" end
    return table.concat(parts, "  |  ")
end

local function createSlot()
    if not WorldSaveManage then
        slotStatus = "WorldSaveManage not found"
        return false
    end
    local name = slotWorldName
    if name == nil or name == "" then name = "My World" end
    lastSlotCreated = nil
    pcall(function()
        WorldSaveManage:FireServer("CreateSlot", name, tostring(slotSeed or ""))
    end)
    slotStatus = ("Creating slot \"%s\"..."):format(name)
    return true
end

local function deleteSlot(n)
    if not WorldSaveManage then
        slotStatus = "WorldSaveManage not found"
        return false
    end
    pcall(function() WorldSaveManage:FireServer("DeleteSlot", math.floor(n)) end)
    slotStatus = ("Deleting slot %d..."):format(n)
    return true
end

if WorldSaveManage then
    WorldSaveManage.OnClientEvent:Connect(function(op, a, b)
        if op == "SlotCreated" then
            lastSlotCreated = tonumber(a)
            local id = (type(b) == "table" and b.SaveID) or slotWorldName
            slotStatus = ("Slot %s created (%s)"):format(tostring(a), tostring(id))
        elseif op == "SlotDeleted" then
            slotStatus = ("Slot %s deleted"):format(tostring(a))
        elseif op == "CreateSlotFailed" then
            slotStatus = ("Create slot failed: %s"):format(tostring(a))
        end
    end)
end

-- make sure a usable save slot exists, and return the index to send with the room
local function ensureSlot()
    if roomMode == "Tutorial" then return nil end          -- tutorial takes no slot
    local want = math.floor(roomSaveSlot)
    if not slotIsEmpty(want) then return want end          -- already has a world
    if not autoSlotEnabled then return want end            -- user handles it

    createSlot()
    local deadline = os.clock() + 5
    while os.clock() < deadline and not lastSlotCreated do task.wait(0.05) end
    return lastSlotCreated or want
end

local function roomLimits()
    local info = roomInfo or {}
    local minP = tonumber(info.MinPlayers) or 1
    local maxP = tonumber(info.MaxPlayers)
        or tonumber(info.FreeMaxPlayers) or 6
    return minP, maxP
end

local function createRoom()
    if not GateRemote then
        roomStatus = "GateRemote not found"
        return false
    end
    if not roomName then
        roomStatus = "No room open — touch a room gate first"
        return false
    end

    if roomMode == "Tutorial" then
        pcall(function() GateRemote:FireServer("CreateRoom", roomName, "Tutorial", 1) end)
        roomStatus = ("Created %s (Tutorial) — auto stopped"):format(roomName)
        roomDone = true
        return true
    end

    -- a world save slot must exist before the room can be entered
    local slot = ensureSlot() or math.floor(roomSaveSlot)

    local minP, maxP = roomLimits()
    local size = math.clamp(math.floor(roomMaxPlayers), minP, maxP)
    pcall(function()
        GateRemote:FireServer("CreateRoom", roomName, roomMode, size, slot)
    end)
    roomStatus = ("Created %s (%s, %d players, slot %d) — auto stopped")
        :format(roomName, roomMode, size, slot)
    roomDone = true
    return true
end

local function cancelRoom()
    if not GateRemote or not roomName then return false end
    pcall(function() GateRemote:FireServer("CancelRoomSetup", roomName) end)
    roomStatus = ("Cancelled %s"):format(roomName)
    roomName, roomInfo = nil, nil
    return true
end

-- touch a gate, wait for the server to answer with OpenRoomSettings,
-- then send the create request with the chosen settings
local function openAndCreate(gateName)
    if roomBusy then return false end
    roomBusy = true

    local tried = {}
    if gateName and gateName ~= "Auto" then
        local g = gatePart(gateName)
        if g then tried[1] = { name = gateName, part = g } end
    else
        tried = listGates()
    end

    if #tried == 0 then
        roomStatus = "No room gate found in workspace.Gate"
        roomBusy = false
        return false
    end

    for _, entry in ipairs(tried) do
        roomName, roomInfo = nil, nil
        roomStatus = ("Touching %s..."):format(entry.name)
        touchGate(entry.part)

        -- wait for the server to open the settings for us
        local deadline = os.clock() + 3
        while os.clock() < deadline and not roomName do task.wait(0.05) end

        if roomName then
            task.wait(0.25)          -- let the UI settle like a real click would
            local made = createRoom()
            roomBusy = false
            return made
        end
    end

    roomStatus = "Gate did not open (room may be taken)"
    roomBusy = false
    return false
end

-- watch the gate: capture the room the server opened for us
if GateRemote then
    GateRemote.OnClientEvent:Connect(function(op, data)
        if op == "OpenRoomSettings" and type(data) == "table" then
            roomInfo = data
            roomName = data.RoomName
            local minP, maxP = roomLimits()
            roomStatus = ("Gate open: %s  (%d-%d players)")
                :format(tostring(roomName), minP, maxP)
        elseif op == "CloseRoomSettings" then
            roomStatus = ("Closed %s"):format(tostring(data or roomName))
            roomName = nil
            roomInfo = nil
        end
    end)
end

-- Auto Create Room: do the whole flow once, then stay quiet.
-- It stops as soon as a room is made or the match map appears (= we are inside
-- a room already), and arms itself again only after returning to the Lobby.
local roomSeenMatch = false   -- we actually got into a room at least once

task.spawn(function()
    while true do
        if not inLobby() then
            -- inside a room / match: never ask for another one
            if not roomDone then roomStatus = "In a room — auto stopped" end
            roomDone      = true
            roomSeenMatch = true
            task.wait(2)

        elseif roomDone then
            -- Still in the Lobby with the job already done. Only re-arm after we
            -- have really been inside a room and come back, otherwise the few
            -- seconds between "created" and the teleport would start a new room.
            if roomSeenMatch then
                roomDone      = false
                roomSeenMatch = false
                roomStatus    = "Back in lobby — auto armed"
            end
            task.wait(2)

        elseif autoRoomEnabled and GateRemote and not roomBusy then
            openAndCreate(roomGateChoice)
            task.wait(3)

        else
            task.wait(IDLE_WAIT)
        end
    end
end)


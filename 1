-- ── LOOP 1: Items + Chest ─────────────────────────────
local currentChestTarget = nil  -- ป้องกัน infinite loop บน target เดิม

task.spawn(function()
    while true do
        task.wait(0.3)
        if not chestEnabled then
            if chestFloating then stopFloatLock() end
            currentChestTarget = nil
            continue
        end
        if isEatingPause then continue end
        if not BuildParts then task.wait(1) continue end

        drainItemsAny()
        if not chestEnabled or isEatingPause then continue end

        -- หาหีบที่ยังไม่ได้เปิด — เลือกอัน "ใกล้ที่สุด" ที่ยังเปิดได้
        local openAll = #chestTargets == 0
        local target, targetDist = nil, math.huge
        for _, obj in ipairs(BuildParts:GetChildren()) do
            if not obj or not obj.Parent then continue end
            if not obj.Name:lower():find("chest") then continue end
            if isChestOpen(obj) then continue end
            -- cooldown: เพิ่งลองไป ข้ามชั่วคราว (กันวนซ้ำ + รอ respawn)
            local cd = chestCooldown[obj]
            if cd and (os.clock() - cd) < CHEST_RETRY_CD then continue end
            local bn = baseName(obj.Name)
            local wanted = openAll
            if not wanted then
                for _, sel in ipairs(chestTargets) do
                    if sel == bn then wanted = true; break end
                end
            end
            if wanted then
                local d = distanceTo(obj)
                if d < targetDist then target = obj; targetDist = d end
            end
        end

        if not target then
            currentChestTarget = nil
            task.wait(1)
            continue
        end

        drainItemsAny()
        if not chestEnabled or isEatingPause then continue end

        -- เช็ค ItemRequire (Golden ต้องใช้ COIN 100)
        -- ครอบด้วย pcall กันกรณี attribute แปลกๆ ทำให้ loop ตาย
        local canOk, canOpen = pcall(canOpenChest, target)
        if canOk and not canOpen then
            chestCooldown[target] = os.clock()  -- ข้ามชั่วคราว (ของไม่พอ) แล้วค่อยลองใหม่
            continue
        end

        currentChestTarget = target
        -- ครอบ openChest ด้วย pcall: ถ้ากล่องเดียว error จะได้ไม่ทำให้
        -- ทั้ง loop พังถาวร (ต้องรันสคริปต์ใหม่)
        local okOpen, errOpen = pcall(openChest, target)
        if not okOpen then
            pcall(function()
                warn("[AutoChest] openChest error:", errOpen)
            end)
            -- เผื่อ float lock ค้าง
            if chestFloating then pcall(stopFloatLock) end
        end

        -- ตั้ง cooldown หลังลองเปิด (จะลองใหม่อีกครั้งเมื่อพ้น CD ถ้ายังไม่เปิด/respawn)
        chestCooldown[target] = os.clock()
        currentChestTarget = nil

        drainItemsAny()
        task.wait(chestDelay)
    end
end)


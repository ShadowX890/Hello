-- ═══════════════════════════════════════════════════
--  SHARED SCAN  (one pass, on a timer, only while something needs it)
--  Replaces the old per-loop workspace:GetDescendants() calls.
-- ═══════════════════════════════════════════════════
local SCAN_INTERVAL = 1.0    -- seconds between scans
local SCAN_DEPTH    = 6      -- how deep to walk
local SCAN_CAP      = 400    -- max entries per cache

local lastScanAt = 0

local function walk(root, depth, items, mons)
    if not root or depth > SCAN_DEPTH then return end
    for _, o in ipairs(root:GetChildren()) do
        local n = o.Name
        if MONSTER_NAMES[n] then
            if #mons < SCAN_CAP then mons[#mons + 1] = o end
        elseif ITEM_NAMES[n] and not CLEANING_TOOLS[n] then
            if #items < SCAN_CAP then items[#items + 1] = o end
            -- an item model can still contain another item, so keep going
            if o:IsA("Model") then walk(o, depth + 1, items, mons) end
        elseif o:IsA("Folder") or o:IsA("Model") then
            walk(o, depth + 1, items, mons)
        end
    end
end

-- An item that appears between scans used to stay un-highlighted for up to a
-- second (and could be picked up before it ever showed). Watching Gameplay lets
-- the next refresh pick it up immediately.
local scanDirty = false

-- force = ignore the timer (used right after toggling something on)
local function runScan(force)
    if not force and not scanDirty and os.clock() - lastScanAt < SCAN_INTERVAL then return end
    lastScanAt = os.clock()
    scanDirty  = false
    local items, mons = {}, {}
    pcall(function() walk(gameplayFolder(), 0, items, mons) end)
    -- monsters may also sit outside Gameplay -> shallow sweep of workspace roots
    pcall(function()
        for _, o in ipairs(workspace:GetChildren()) do
            if MONSTER_NAMES[o.Name] then
                if #mons < SCAN_CAP then mons[#mons + 1] = o end
            elseif o:IsA("Folder") and o.Name ~= "Gameplay" then
                walk(o, SCAN_DEPTH - 2, items, mons)
            end
        end
    end)
    itemCache, monsterCache = items, mons
end

-- mark dirty as soon as something relevant is added to the play area
task.spawn(function()
    local gp = gameplayFolder()
    if not gp then
        local ok = pcall(function() gp = workspace:WaitForChild("Gameplay", 30) end)
        if not ok or not gp then return end
    end
    gp.DescendantAdded:Connect(function(o)
        local n = o.Name
        if MONSTER_NAMES[n] or (ITEM_NAMES[n] and not CLEANING_TOOLS[n]) then
            scanDirty = true
        end
    end)
end)


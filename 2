-- ═══════════════════════════════════════════════════
--  Anomaly detector loop — notify once per visitor, keep paragraph live
-- ═══════════════════════════════════════════════════
task.spawn(function()
    local lastVisitor = nil
    while true do
        if visitorEsp then refreshVisitorEsp() end
        if anomalyDetect then
            local isAnom, vid = readVisitor()
            if vid == nil then
                lastVisitor = nil    -- door empty, reset so the next visitor alerts
                pcall(function()
                    DetectorParagraph:Set({ Title = "Visitor", Content = "No one at the door." })
                end)
            else
                local info = visitorInfo(vid)
                local who = info and info.name or tostring(vid)
                if vid ~= lastVisitor then
                    lastVisitor = vid
                    if isAnom == true then
                        Rayfield:Notify({
                            Title = "ANOMALY! — " .. who,
                            Content = "DO NOT let it in!  Clue: " .. anomalyClue(info),
                            Duration = 7,
                        })
                    elseif info and not info.canBeAnomaly then
                        Rayfield:Notify({
                            Title = "Safe — " .. who,
                            Content = "This visitor is always human. Let it in.",
                            Duration = 5,
                        })
                    else
                        Rayfield:Notify({
                            Title = "Safe — " .. who,
                            Content = "Not an Anomaly. Safe to let it in.",
                            Duration = 5,
                        })
                    end
                end
                local verdict
                if isAnom == true then
                    verdict = "ANOMALY — do NOT let it in!\nClue: " .. anomalyClue(info)
                elseif info and not info.canBeAnomaly then
                    verdict = "Always human — 100% safe to let in."
                else
                    verdict = "Human — safe to let in."
                end
                pcall(function()
                    DetectorParagraph:Set({
                        Title = "Visitor: " .. who,
                        Content = string.format("%s\n%s", info and info.desc or "", verdict),
                    })
                end)
            end
            task.wait(0.2)
        else
            pcall(function()
                DetectorParagraph:Set({ Title = "Visitor", Content = "Detector is off." })
            end)
            task.wait(0.5)
        end
    end
end)

-- ═══════════════════════════════════════════════════
--  ESP loop  (one scan drives both item and monster ESP)
-- ═══════════════════════════════════════════════════
task.spawn(function()
    local monsterWasOff, itemWasOff = true, true
    while true do
        if itemEsp or monsterEsp then
            runScan()
            if itemEsp then refreshItemEsp() end
            if monsterEsp then
                refreshEsp()
                local mons = monsterList()
                local ctxt = (#mons > 0)
                    and ("Monsters nearby:\n" .. table.concat(mons, ", "))
                    or "No monsters spotted."
                pcall(function() MonsterParagraph:Set({ Title = "Monsters", Content = ctxt }) end)
                monsterWasOff = false
            elseif not monsterWasOff then
                pcall(function() MonsterParagraph:Set({ Title = "Monsters", Content = "ESP is off." }) end)
                monsterWasOff = true
            end
            itemWasOff = false
            task.wait(SCAN_INTERVAL)
        else
            if not monsterWasOff then
                pcall(function() MonsterParagraph:Set({ Title = "Monsters", Content = "ESP is off." }) end)
                monsterWasOff = true
            end
            itemWasOff = true
            task.wait(1)
        end
    end
end)

-- ═══════════════════════════════════════════════════
--  Status updater
-- ═══════════════════════════════════════════════════
task.spawn(function()
    while true do
        local info = queueInfo()
        local line
        if info then
            line = string.format("In queue: %s\nPlayers: %d/%s",
                tostring(info.id), info.count, tostring(info.size or "?"))
        else
            line = "Not in a room"
        end
        local txt = string.format(
            "Mode: %s\nRoom: %d\nRooms available: %d\n%s",
            selectedMode, selectedIndex, #listZones(selectedMode), line)
        pcall(function() Status:Set({ Title = "Status", Content = txt }) end)

        -- counts come from the shared cache; refresh it only if no ESP is running
        if not (itemEsp or monsterEsp) then runScan() end
        local nItems = #itemCache
        local ctxt = string.format("Item ESP: %s\nItems to clean: %d",
            itemEsp and "ON" or "OFF", nItems)
        pcall(function() CleanParagraph:Set({ Title = "Item ESP", Content = ctxt }) end)

        -- Task Tracker: active tasks (if exposed) + remaining items by type
        local ttxt = {}
        local at = activeTasks()
        if type(at) == "table" then
            local names = {}
            for k, v in pairs(at) do
                names[#names + 1] = taskText(type(v) == "string" and v or k)
            end
            if #names > 0 then ttxt[#ttxt + 1] = "Active: " .. table.concat(names, ", ") end
        end
        local rem = remainingItems()
        local parts = {}
        for name, n in pairs(rem) do parts[#parts + 1] = string.format("%s x%d", name, n) end
        ttxt[#ttxt + 1] = (#parts > 0) and ("Left to clean:\n" .. table.concat(parts, ", "))
                                       or "Nothing left to clean."
        pcall(function() TaskParagraph:Set({ Title = "Task Tracker", Content = table.concat(ttxt, "\n") }) end)
        task.wait(1.5)
    end
end)

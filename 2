-- ═══════════════════════════════════════════════════
--  VISITOR ESP  (red = anomaly, green = human)
-- ═══════════════════════════════════════════════════
local visitorEsp = false
local visitorHighlight = nil

-- Highlights get a known name so they can be swept up even if the variable
-- lost track of one (visitor swapped, model rebuilt, round restarted).
local VISITOR_ESP_TAG = "SXH_VisitorESP"

local function clearVisitorEsp()
    if visitorHighlight then
        pcall(function() visitorHighlight:Destroy() end)
        visitorHighlight = nil
    end
    -- sweep any leftovers we created earlier
    for _, o in ipairs(workspace:GetChildren()) do
        if o.Name:sub(1, 8) == "visitor_" or o.Name == "ServerRig" then
            for _, d in ipairs(o:GetDescendants()) do
                if d.Name == VISITOR_ESP_TAG then
                    pcall(function() d:Destroy() end)
                end
            end
            local direct = o:FindFirstChild(VISITOR_ESP_TAG)
            if direct then pcall(function() direct:Destroy() end) end
        end
    end
end

-- ServerRig only carries the attributes. The person at the door is a separate
-- model sitting in workspace, named exactly like the visitorId attribute
-- ("visitor_gym", "visitor_mib", ...), so that is what gets highlighted.
local function visitorModel()
    local rig = serverRig()
    local vid = rig and rig:GetAttribute("visitorId")

    local function usable(o)
        return o and o:IsA("Model") and o:FindFirstChildWhichIsA("BasePart", true) ~= nil
    end

    -- 1) straight from the id
    if vid then
        local m = workspace:FindFirstChild(tostring(vid))
        if usable(m) then return m end
    end

    -- 2) otherwise take whichever visitor_* model is in the world right now
    for _, o in ipairs(workspace:GetChildren()) do
        if o.Name:sub(1, 8) == "visitor_" and usable(o) then
            return o
        end
    end

    return nil
end

local function refreshVisitorEsp()
    -- hard stop: never build a highlight while the toggle is off
    if not visitorEsp then
        clearVisitorEsp()
        return
    end

    local rig = serverRig()
    local isAnom = rig and rig:GetAttribute("isAnomaly")

    if not rig or isAnom == nil then
        clearVisitorEsp()
        return
    end

    local target = visitorModel()
    if not target then
        clearVisitorEsp()
        return
    end

    if visitorHighlight and visitorHighlight.Adornee ~= target then
        clearVisitorEsp()
    end

    if not visitorHighlight then
        local ok, hl = pcall(function()
            local h = Instance.new("Highlight")
            h.Name = VISITOR_ESP_TAG
            h.FillTransparency = 0.4
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = target
            -- parent under CoreGui-safe container: the model itself is fine and
            -- gets cleaned up with it
            h.Parent = target
            return h
        end)
        if ok then visitorHighlight = hl else return end
    end

    local red   = Color3.fromRGB(255, 45, 45)
    local green = Color3.fromRGB(60, 230, 90)
    local c = (isAnom == true) and red or green
    pcall(function()
        visitorHighlight.FillColor = c
        visitorHighlight.OutlineColor = c
    end)
end

-- ═══════════════════════════════════════════════════
--  PLAYER  (tp walk / noclip / fly)
-- ═══════════════════════════════════════════════════
local RunService       = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")

local tpWalkEnabled = false
local tpWalkSpeed   = 3      -- studs added per frame

local noclipEnabled = false
local noclipSaved   = {}     -- [BasePart] = true  (parts we actually switched off)

local flyEnabled = false
local flySpeed   = 60

local function humanoid()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- ── TP Walk ───────────────────────────────────────────────────
-- Moves the root a little every frame instead of raising WalkSpeed, so
-- Humanoid.WalkSpeed still reads as the normal value.
RunService.Heartbeat:Connect(function()
    if not tpWalkEnabled or flyEnabled then return end
    local hum  = humanoid()
    local root = getRoot()
    if not hum or not root then return end
    local dir = hum.MoveDirection
    if dir.Magnitude < 0.1 then return end
    pcall(function()
        root.CFrame = root.CFrame + dir * tpWalkSpeed
    end)
end)

-- ── Noclip ────────────────────────────────────────────────────
-- Only parts that were solid get switched off, and only those get restored,
-- so parts the game keeps non-solid stay that way.
local function applyNoclip()
    local c = LocalPlayer.Character
    if not c then return end
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            noclipSaved[part] = true
            pcall(function() part.CanCollide = false end)
        end
    end
end

local function restoreNoclip()
    for part in pairs(noclipSaved) do
        if part and part.Parent then
            pcall(function() part.CanCollide = true end)
        end
    end
    noclipSaved = {}
end

RunService.Stepped:Connect(function()
    if noclipEnabled then applyNoclip() end
end)

-- ── Fly ───────────────────────────────────────────────────────
local flyBV, flyBG = nil, nil

local function stopFly()
    if flyBV then pcall(function() flyBV:Destroy() end) flyBV = nil end
    if flyBG then pcall(function() flyBG:Destroy() end) flyBG = nil end
    local hum = humanoid()
    if hum then pcall(function() hum.PlatformStand = false end) end
end

local function startFly()
    local root = getRoot()
    local hum  = humanoid()
    if not root or not hum then return end
    stopFly()

    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1, 1, 1) * 9e9
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1, 1, 1) * 9e9
    flyBG.P = 9e4
    flyBG.CFrame = root.CFrame
    flyBG.Parent = root

    pcall(function() hum.PlatformStand = true end)
end

RunService.Heartbeat:Connect(function()
    if not flyEnabled then return end
    local root = getRoot()
    local hum  = humanoid()
    local cam  = workspace.CurrentCamera
    if not root or not hum or not cam or not flyBV then return end

    -- movement comes from the humanoid, so keyboard and mobile both work
    local dir = hum.MoveDirection
    local move = Vector3.zero
    if dir.Magnitude > 0.1 then move = dir end

    -- vertical: jump key / space lifts, shift lowers
    local up = 0
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then up = up + 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then up = up - 1 end

    local vel = (move + Vector3.new(0, up, 0))
    if vel.Magnitude > 0 then vel = vel.Unit * flySpeed else vel = Vector3.zero end

    pcall(function()
        flyBV.Velocity = vel
        if flyBG then flyBG.CFrame = cam.CFrame end
    end)
end)


-- rebuilt whenever the room dropdown is refreshed: label -> zone object
local roomMap = {}

local function roomOptions(mode)
    roomMap = {}
    local opts = {}
    for i, z in ipairs(listZones(mode)) do
        local label = zoneLabel(mode, i, z)
        roomMap[label] = z
        opts[#opts + 1] = label
    end
    if #opts == 0 then opts = { "No rooms found" } end
    return opts
end

local function selectedZone()
    return listZones(selectedMode)[selectedIndex]
end

-- ═══════════════════════════════════════════════════
--  Auto Rejoin loop — keep walking into the room if pushed back to lobby
-- ═══════════════════════════════════════════════════
task.spawn(function()
    while true do
        if autoRejoin then
            if not currentZoneId() then       -- not queued right now
                local z = selectedZone()
                if z then joinZone(z) end
            end
            task.wait(2)
        else
            task.wait(0.5)
        end
    end
end)


-- ═══════════════════════════════════════════════════
--  BACKGROUND SERVICES  (always on, no toggle)
-- ═══════════════════════════════════════════════════
local ProximityPromptService = game:GetService("ProximityPromptService")

-- 1) No hold cooldown: completing the hold the moment it starts.
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if typeof(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt) end)
    end
end)

-- 2) Instant prompts: strip the hold time from every prompt in the place,
--    so anything that normally needs holding finishes at once.
-- The game disables prompts it does not want used yet (the light switch is the
-- obvious one) and puts them back to disabled on its own, so setting Enabled
-- once does nothing. Keep a list and re-apply on a timer.
local promptList = {}

local function makeInstant(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    promptList[prompt] = true
    pcall(function()
        prompt.Enabled              = true
        prompt.HoldDuration         = 0
        prompt.RequiresLineOfSight  = false
        if prompt.MaxActivationDistance < 25 then
            prompt.MaxActivationDistance = 25
        end
    end)
end

task.spawn(function()
    for _, d in ipairs(workspace:GetDescendants()) do makeInstant(d) end
end)
workspace.DescendantAdded:Connect(makeInstant)

-- re-apply, and drop prompts that were removed
task.spawn(function()
    while true do
        for prompt in pairs(promptList) do
            if prompt.Parent then
                if not prompt.Enabled or prompt.HoldDuration > 0 then
                    pcall(function()
                        prompt.Enabled      = true
                        prompt.HoldDuration = 0
                    end)
                end
            else
                promptList[prompt] = nil
            end
        end
        task.wait(0.5)
    end
end)

-- fire a prompt by name, wherever it lives (used by the light switch button)
local function firePromptNamed(parentName)
    local hit = 0
    for prompt in pairs(promptList) do
        local holder = prompt.Parent
        if holder and holder.Name == parentName then
            makeInstant(prompt)
            if typeof(fireproximityprompt) == "function" then
                pcall(function() fireproximityprompt(prompt) end)
                hit = hit + 1
            end
        end
    end
    return hit
end


--  Anomaly detector
--  workspace.ServerRig attribute "isAnomaly" (true = anomaly, false = human)
--  "visitorId" changes per visitor → used to notify once per knock, and it is
--  also the name of the visitor model in workspace (workspace.visitor_gym)
-- ═══════════════════════════════════════════════════
local function serverRig()
    return workspace:FindFirstChild("ServerRig")
end

-- returns isAnomaly(boolean|nil), visitorId
local function readVisitor()

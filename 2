-- ═══════════════════════════════════════════════════
--  Home Alone — Lobby Hub
--  Join matchmaking rooms (Infinite / Story)
--  Join = walk into a MatchmakingZone (zone based, no remote)
-- ═══════════════════════════════════════════════════
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer       = Players.LocalPlayer

local function grab(fn) local ok, r = pcall(fn) return ok and r or nil end

-- Utils module drives matchmaking state (used only for Leave + status)
local Utils = grab(function() return require(ReplicatedStorage:WaitForChild("Utils", 10)) end)

-- ═══════════════════════════════════════════════════
--  Character helpers
-- ═══════════════════════════════════════════════════
local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- ═══════════════════════════════════════════════════
--  Matchmaking zones
--  workspace.Lobby.Matchmaking.[Infinite|Story] → children named "MatchmakingZone"
-- ═══════════════════════════════════════════════════
local MODES = { "Infinite", "Story" }

local function matchmakingFolder(mode)
    local lobby = workspace:FindFirstChild("Lobby")
    local mm = lobby and lobby:FindFirstChild("Matchmaking")
    return mm and mm:FindFirstChild(mode)
end

-- position of a zone (works for Part or Model)
local function zonePos(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    local ok, cf = pcall(function() return obj:GetPivot() end)
    if ok and typeof(cf) == "CFrame" then return cf.Position end
    return nil
end

-- list all MatchmakingZone objects of a mode, in child order
local function listZones(mode)
    local folder = matchmakingFolder(mode)
    if not folder then return {} end
    local out = {}
    for _, child in ipairs(folder:GetChildren()) do
        if child.Name == "MatchmakingZone" and zonePos(child) then
            out[#out + 1] = child
        end
    end
    return out
end

-- readable label for a zone (uses "size" attribute if the game sets one)
local function zoneLabel(mode, index, obj)
    local size = obj:GetAttribute("size") or obj:GetAttribute("Size")
    if type(size) == "number" then
        return string.format("%s Room %d  (%d players)", mode, index, size)
    end
    return string.format("%s Room %d", mode, index)
end

-- ═══════════════════════════════════════════════════
--  Join / Leave
-- ═══════════════════════════════════════════════════
local function joinZone(obj)
    local hrp = getRoot()
    local p = zonePos(obj)
    if not hrp or not p then return false end
    pcall(function() hrp.CFrame = CFrame.new(p + Vector3.new(0, 3, 0)) end)
    return true
end

-- id of the matchmaking zone the local player is currently queued in
local function currentZoneId()
    if not Utils then return nil end
    local ok, res = pcall(function()
        for id, z in Utils.Value.client.readGlobal("matchmaking") do
            if z.players and table.find(z.players, LocalPlayer) then
                return id
            end
        end
        return nil
    end)
    return ok and res or nil
end

local function queueInfo()
    if not Utils then return nil end
    local ok, info = pcall(function()
        local mm = Utils.Value.client.readGlobal("matchmaking")
        local id = currentZoneId()
        local z = id and mm and mm[id]
        if z then
            return { id = id, count = #z.players, size = z.size }
        end
        return nil
    end)
    return ok and info or nil
end

local function leaveMatch()
    if not Utils then return false end
    local id = currentZoneId()
    if not id then return false end
    pcall(function() Utils.Event.fire("leaveMatchmaking", id) end)
    return true
end

-- ═══════════════════════════════════════════════════
--  Anomaly detector
--  workspace.ServerRig attribute "isAnomaly" (true = anomaly, false = human)
--  "visitorId" changes per visitor → used to notify once per knock
-- ═══════════════════════════════════════════════════
local function serverRig()
    return workspace:FindFirstChild("ServerRig")
end

-- returns isAnomaly(boolean|nil), visitorId
local function readVisitor()
    local rig = serverRig()
    if not rig then return nil, nil end
    return rig:GetAttribute("isAnomaly"), rig:GetAttribute("visitorId")
end

-- ═══════════════════════════════════════════════════
--  Item ESP  (highlight things that need cleaning)
--  Cleaning is multi-step, so we DON'T auto it — just show where the mess is.
--  Items live under workspace.Gameplay. Names come from Data.Items.
-- ═══════════════════════════════════════════════════
local ITEM_NAMES = {}
do
    local ItemsData = grab(function()
        return require(ReplicatedStorage:WaitForChild("Data", 10):WaitForChild("Items", 10))
    end)
    if ItemsData and ItemsData.getAll then
        for name in pairs(ItemsData.getAll()) do ITEM_NAMES[name] = true end
    else
        for _, n in ipairs({
            "sponge","piano","whiteCat","blackCat","shaker","bread","pan","pasta",
            "dishPile","dish","wifiPassword","phone","pizza","mop","sprayBottle",
            "sprayBotttleTwo","basketBall","puddle","dirtPuddle","tshirt","waterCan",
            "janitorCart","spiderWeb","coffeeBean","carToy","clothesPile",
            "crayonBk","crayonBox","crayonBu","crayonG","crayonJ","crayonV",
            "randomBox","randomBox1","randomBox2","randomBox3",
        }) do ITEM_NAMES[n] = true end
    end
end

-- cleaning TOOLS (the things you clean WITH) — never highlight these
local CLEANING_TOOLS = {
    sponge = true, mop = true, sprayBottle = true, sprayBotttleTwo = true,
    waterCan = true, janitorCart = true,
}

local function gameplayFolder()
    return workspace:FindFirstChild("Gameplay")
end

local function objPos(o)
    if not o then return nil end
    if o:IsA("BasePart") then return o.Position end
    local ok, cf = pcall(function() return o:GetPivot() end)
    if ok and typeof(cf) == "CFrame" then return cf.Position end
    return nil
end

-- a cleanable = a real item that is NOT a cleaning tool
local function isCleanable(o)
    if not (o:IsA("Model") or o:IsA("BasePart")) then return false end
    return ITEM_NAMES[o.Name] == true and not CLEANING_TOOLS[o.Name]
end

-- Scan results live here; a single timed scan fills them (see runScan below).
-- Re-walking the tree inside every loop is what made the obfuscated build lag:
-- an obfuscator turns each instruction into many, so hot loops pay it back hard.
local itemCache    = {}
local monsterCache = {}

local function listCleanables()
    return itemCache
end

-- item ESP highlights
local itemEspCache = {}
local function clearItemEsp()
    for o, h in pairs(itemEspCache) do pcall(function() h:Destroy() end) end
    itemEspCache = {}
end
local function refreshItemEsp()
    local seen = {}
    for _, o in ipairs(listCleanables()) do
        seen[o] = true
        if not itemEspCache[o] then
            local ok, h = pcall(function()
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(80, 220, 120)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.55
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = o
                hl.Parent = o
                return hl
            end)
            if ok then itemEspCache[o] = h end
        end
    end
    -- drop highlights for items no longer present (cleaned/removed)
    for o, h in pairs(itemEspCache) do
        if not seen[o] or not o.Parent then
            pcall(function() h:Destroy() end)
            itemEspCache[o] = nil
        end
    end
end


local DataFolder = grab(function() return ReplicatedStorage:WaitForChild("Data", 10) end)

-- ── Visitor identity (Data.Visitors) ────────────────────────
local VisitorsData = grab(function() return require(DataFolder:WaitForChild("Visitors", 10)) end)

-- friendly wording for the anomaly clue kinds
local KIND_HINTS = {
    invisible = "it's invisible",
    xrayModelSwap = "wrong body under x-ray",
    voiceChange = "voice sounds off",
    explosion = "will explode",
    bat = "a bat is with it",
    backyard = "something in the backyard",
    danceWatch = "it dances when watched",
    photographer = "taking photos",
    policeChase = "being chased",
    neuralyzer = "flashes a neuralyzer",
    cameraModelSwapStare = "changes on camera when stared at",
    firstCamProximity = "too close on first camera",
    suddenAppearance = "appears suddenly",
}

-- vid -> { name, desc, canBeAnomaly, kinds{} }
local function visitorInfo(vid)
    if not vid or not VisitorsData or not VisitorsData.getAll then return nil end
    local all = VisitorsData.getAll()
    local def = all[vid] or all["visitor_" .. tostring(vid)]
    if not def then
        for _, v in pairs(all) do
            if v.specificId == vid then def = v break end
        end
    end
    if not def then return nil end
    return {
        name = def.displayName or tostring(vid),
        desc = def.description or "",
        canBeAnomaly = def.anomaly ~= nil,
        kinds = (def.anomaly and def.anomaly.anomalyKinds) or {},
    }
end

local function anomalyClue(info)
    if not info or not info.kinds or #info.kinds == 0 then return "unknown" end
    local parts = {}
    for _, k in ipairs(info.kinds) do
        parts[#parts + 1] = KIND_HINTS[k] or k
    end
    return table.concat(parts, ", ")
end

-- ── Monster ESP (Data.Monsters) ─────────────────────────────
local MonstersData = grab(function() return require(DataFolder:WaitForChild("Monsters", 10)) end)
local MONSTER_NAMES = {}
if MonstersData and MonstersData.getAll then
    for name, def in pairs(MonstersData.getAll()) do
        MONSTER_NAMES[name] = def.displayName or name
    end
else
    MONSTER_NAMES = { skinCrawler = "Skin Crawler", hand = "Hand" }
end

-- ═══════════════════════════════════════════════════
--  SHARED SCAN  (one pass, on a timer, only while something needs it)
--  Replaces the old per-loop workspace:GetDescendants() calls.
-- ═══════════════════════════════════════════════════
local SCAN_INTERVAL = 1.0    -- seconds between scans
local SCAN_DEPTH    = 5      -- how deep to walk
local SCAN_CAP      = 250    -- max entries per cache

local lastScanAt = 0

local function walk(root, depth, items, mons)
    if not root or depth > SCAN_DEPTH then return end
    for _, o in ipairs(root:GetChildren()) do
        local n = o.Name
        if MONSTER_NAMES[n] then
            if #mons < SCAN_CAP then mons[#mons + 1] = o end
        elseif ITEM_NAMES[n] and not CLEANING_TOOLS[n] then
            if #items < SCAN_CAP then items[#items + 1] = o end
        elseif o:IsA("Folder") or o:IsA("Model") then
            walk(o, depth + 1, items, mons)
        end
    end
end

-- force = ignore the timer (used right after toggling something on)
local function runScan(force)
    if not force and os.clock() - lastScanAt < SCAN_INTERVAL then return end
    lastScanAt = os.clock()
    local items, mons = {}, {}
    pcall(function() walk(gameplayFolder(), 0, items, mons) end)
    -- monsters may also sit outside Gameplay -> shallow sweep of workspace roots
    pcall(function()
        for _, o in ipairs(workspace:GetChildren()) do
            if MONSTER_NAMES[o.Name] then
                if #mons < SCAN_CAP then mons[#mons + 1] = o end
            elseif o:IsA("Folder") and o.Name ~= "Gameplay" then
                walk(o, SCAN_DEPTH - 2, items, mons)
            end
        end
    end)
    itemCache, monsterCache = items, mons
end

local espCache = {}   -- [model] = Highlight
local function clearEsp()
    for m, h in pairs(espCache) do pcall(function() h:Destroy() end) end
    espCache = {}
end

local function refreshEsp()
    local seen = {}
    for _, o in ipairs(monsterCache) do
        seen[o] = true
        if not espCache[o] and o.Parent then
            local ok, h = pcall(function()
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 40, 40)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.5
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = o
                hl.Parent = o
                return hl
            end)
            if ok then espCache[o] = h end
        end
    end
    for m, h in pairs(espCache) do
        if not seen[m] or not m.Parent then
            pcall(function() h:Destroy() end)
            espCache[m] = nil
        end
    end
end

local function monsterList()
    local out = {}
    for _, o in ipairs(monsterCache) do
        out[#out + 1] = MONSTER_NAMES[o.Name] or o.Name
    end
    return out
end

-- ── Equipment shop (Data.Equipments) ────────────────────────
local EquipmentsData = grab(function() return require(DataFolder:WaitForChild("Equipments", 10)) end)

-- buyable = has a price (skip gamepass-only items)
local equipLabelToName = {}
local function equipOptions()
    equipLabelToName = {}
    local opts = {}
    if EquipmentsData and EquipmentsData.getAll then
        for name, def in pairs(EquipmentsData.getAll()) do
            if def.price then
                local label = string.format("%s  ($%d)", def.displayName or name, def.price)
                equipLabelToName[label] = name
                opts[#opts + 1] = label
            end
        end
    end
    if #opts == 0 then opts = { "No equipment data" } end
    return opts
end

-- buy via the confirmed remote: Remotes.tryBuyEquipment:FireServer(itemName)
local tryBuyEquipment = grab(function()
    return ReplicatedStorage:WaitForChild("Remotes", 10):WaitForChild("tryBuyEquipment", 10)
end)

local function buyEquipment(name)
    if not name then return false, "no item" end
    if not tryBuyEquipment then return false, "tryBuyEquipment remote missing" end
    pcall(function() tryBuyEquipment:FireServer(name) end)
    return true, "tryBuyEquipment"
end

-- ── Task tracker ────────────────────────────────────────────
local TasksData = grab(function() return require(DataFolder:WaitForChild("Tasks", 10)) end)

-- items still lying around, grouped by name (what's left to clean)
local function remainingItems()
    local counts = {}
    for _, o in ipairs(listCleanables()) do
        counts[o.Name] = (counts[o.Name] or 0) + 1
    end
    return counts
end

-- the server's current active tasks (if exposed through Utils global)
local function activeTasks()
    if not Utils then return nil end
    local ok, res = pcall(function() return Utils.Value.client.readGlobal("tasks") end)
    return ok and res or nil
end

local function taskText(id)
    if TasksData and TasksData.get then
        local ok, def = pcall(function() return TasksData.get(id) end)
        if ok and def and def.displayText then return def.displayText end
    end
    return tostring(id)
end


